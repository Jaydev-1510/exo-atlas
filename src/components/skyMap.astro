---
interface Props {
  rightAscension: number | null;
  declination: number | null;
  name: string;
}

const { rightAscension, declination, name } = Astro.props;
---

<section class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6">
  <h2 class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4">
    Sky map — where to find it
  </h2>
  {
    rightAscension != null && declination != null ? (
      <div class="relative">
        <canvas
          id="sky-canvas"
          width="600"
          height="220"
          style="width:100%;height:220px;border-radius:8px;border:1px solid #1f1f1f"
        />
        <div
          id="sky-tooltip"
          style="display:none;position:absolute;background:var(--ds-background-100);border:0.5px solid var(--ds-gray-400);border-radius:6px;padding:6px 10px;font-size:11px;font-family:var(--font-geist-mono);color:var(--secondary);pointer-events:none"
        />
      </div>
    ) : (
      <div class="text-sm text-gray-600 py-6 text-center">
        No sky coordinates available for this planet
      </div>
    )
  }
</section>

<script is:inline define:vars={{ rightAscension, declination, starName: name }}>
  if (rightAscension != null && declination != null) {
    const canvas = document.getElementById("sky-canvas");
    canvas.width = canvas.offsetWidth || 600;
    const canvasWidth = canvas.width,
      canvasHeight = canvas.height;
    const context = canvas.getContext("2d");

    context.fillStyle = "#000000";
    context.fillRect(0, 0, canvasWidth, canvasHeight);

    context.strokeStyle = "rgba(255,255,255,0.04)";
    context.lineWidth = 0.5;
    for (let r = 0; r <= 360; r += 30) {
      const x = (r / 360) * canvasWidth;
      context.beginPath();
      context.moveTo(x, 0);
      context.lineTo(x, canvasHeight);
      context.stroke();
    }

    for (let d = -90; d <= 90; d += 30) {
      const y = ((90 - d) / 180) * canvasHeight;
      context.beginPath();
      context.moveTo(0, y);
      context.lineTo(canvasWidth, y);
      context.stroke();
    }

    context.fillStyle = "rgba(255,255,255,0.2)";
    context.font = "9px monospace";
    for (let r = 0; r <= 360; r += 60) {
      context.fillText(`${r}°`, (r / 360) * canvasWidth + 2, canvasHeight - 4);
    }
    for (let d = -60; d <= 90; d += 30) {
      context.fillText(
        `${d > 0 ? "+" : ""}${d}°`,
        2,
        ((90 - d) / 180) * canvasHeight - 2,
      );
    }

    const seed = 42;
    function rand(n) {
      return (((Math.sin(n * seed) * 43758.5453) % 1) + 1) % 1;
    }
    for (let i = 0; i < 400; i++) {
      const sx = rand(i * 3) * canvasWidth;
      const sy = rand(i * 3 + 1) * canvasHeight;
      const size = rand(i * 3 + 2) * 1.2;
      context.beginPath();
      context.arc(sx, sy, size, 0, Math.PI * 2);
      context.fillStyle = `rgba(255,255,255,${0.1 + rand(i) * 0.5})`;
      context.fill();
    }

    const neighbors = [
      { rightAscension: rightAscension + 8, declination: declination + 5 },
      { rightAscension: rightAscension - 12, declination: declination - 8 },
      { rightAscension: rightAscension + 20, declination: declination + 2 },
      { rightAscension: rightAscension - 5, declination: declination + 14 },
      { rightAscension: rightAscension + 15, declination: declination - 10 },
    ];
    neighbors.forEach((neighbor) => {
      const nx =
        ((((neighbor.rightAscension % 360) + 360) % 360) / 360) * canvasWidth;
      const ny =
        ((90 - Math.max(-90, Math.min(90, neighbor.declination))) / 180) *
        canvasHeight;
      context.beginPath();
      context.arc(nx, ny, 1.5, 0, Math.PI * 2);
      context.fillStyle = "rgba(255,255,255,0.4)";
      context.fill();

      const hx = ((((rightAscension % 360) + 360) % 360) / 360) * canvasWidth;
      const hy = ((90 - declination) / 180) * canvasHeight;
      context.beginPath();
      context.moveTo(nx, ny);
      context.lineTo(hx, hy);
      context.strokeStyle = "rgba(255,255,255,0.04)";
      context.lineWidth = 0.5;
      context.stroke();
    });

    const hx = ((((rightAscension % 360) + 360) % 360) / 360) * canvasWidth;
    const hy = ((90 - declination) / 180) * canvasHeight;

    [16, 10, 6].forEach((r, i) => {
      context.beginPath();
      context.arc(hx, hy, r, 0, Math.PI * 2);
      context.fillStyle = `rgba(255,208,96,${[0.04, 0.08, 0.15][i]})`;
      context.fill();
    });

    context.beginPath();
    context.arc(hx, hy, 3.5, 0, Math.PI * 2);
    context.fillStyle = "#ffd060";
    context.fill();

    context.fillStyle = "rgba(255,208,96,0.9)";
    context.font = "11px monospace";
    context.fillText(starName, hx + 10, hy - 8);

    context.fillStyle = "rgba(255,255,255,0.3)";
    context.font = "10px monospace";
    context.textAlign = "right";
    context.fillText(
      `RA ${rightAscension.toFixed(4)}°  Dec ${declination.toFixed(4)}°`,
      canvasWidth - 8,
      canvasHeight - 6,
    );

    context.strokeStyle = "rgba(255,208,96,0.25)";
    context.lineWidth = 0.5;
    context.setLineDash([4, 4]);
    context.beginPath();
    context.moveTo(hx, 0);
    context.lineTo(hx, canvasHeight);
    context.stroke();
    context.beginPath();
    context.moveTo(0, hy);
    context.lineTo(canvasWidth, hy);
    context.stroke();
    context.setLineDash([]);
  }
</script>
