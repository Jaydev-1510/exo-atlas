---
import Layout from "@/layouts/base.astro";
import Icon from "@/components/icons.astro";
import SkyMap from "@/components/skyMap.astro";
import { supabase } from "@/lib/supabase";

export const prerender = false;

const { slug } = Astro.params;
const { data: planet } = await supabase
  .rpc("get_planet_by_slug", { p_name: slug ?? "" })
  .single();

if (!planet) return Astro.redirect("/atlas");

const fmt = (v: number | null, d = 2) =>
  v != null ? Number(v).toFixed(d) : "—";

const period =
  planet.orbital_period == null
    ? "—"
    : planet.orbital_period < 1
      ? `${(planet.orbital_period * 24).toFixed(1)}h`
      : planet.orbital_period > 1000
        ? `${(planet.orbital_period / 365.25).toFixed(1)} yr`
        : `${planet.orbital_period.toFixed(1)} days`;

const typeLabels: Record<string, string> = {
  rocky: "Rocky",
  "super-earth": "Super-earth",
  "sub-neptune": "Sub-neptune",
  "neptune-like": "Neptune-like",
  "ocean-world": "Ocean world",
  "hot-jupiter": "Hot Jupiter",
  "gas-giant": "Gas giant",
  unknown: "Unknown",
};

const typeStyles: Record<string, string> = {
  rocky: "bg-amber-100 text-amber-500",
  "super-earth": "bg-teal-200 text-teal-800",
  "sub-neptune": "bg-blue-200 text-blue-800",
  "neptune-like": "bg-blue-200 text-blue-800",
  "ocean-world": "bg-blue-200 text-blue-800",
  "hot-jupiter": "bg-amber-200 text-amber-800",
  "gas-giant": "bg-purple-200 text-purple-800",
  unknown: "bg-gray-200 text-gray-700",
};

const habColor =
  (planet.habitability_pct ?? 0) >= 70
    ? "var(--ds-green-600)"
    : (planet.habitability_pct ?? 0) >= 40
      ? "var(--ds-amber-600)"
      : "var(--ds-red-600)";

const planetType = planet.planet_type ?? "unknown";

const { data: similarPlanets } = await supabase.rpc("get_similar_planets", {
  p_planet_id: planet.id,
  p_limit: 4,
});
---

<Layout title={`${planet.name} — Exoplanet Atlas`}>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <header class="mb-8 flex items-baseline justify-between">
      <nav aria-label="Breadcrumb">
        <a
          href="/atlas"
          rel="up"
          class="text-md text-gray-600 hover:text-secondary transition-colors flex gap-1 items-center group"
          ><Icon
            glyph="arrow-left"
            class="group-hover:-translate-x-2 group-hover:scale-110 transition-all duration-300"
          />Atlas</a
        >
      </nav>
      <div class="flex items-center gap-3 mt-4">
        <button
          id="bookmark-btn"
          type="button"
          aria-label="Save planet to local collection"
          data-planet={JSON.stringify({
            id: planet.id,
            name: planet.name,
            host_star: planet.host_star,
            planet_type: planet.planet_type,
            habitability_pct: planet.habitability_pct,
            radius_earth: planet.radius_earth,
            discovery_year: planet.discovery_year,
          })}
          class="flex items-center gap-2 text-xs border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:border-gray-500 transition-colors"
        >
          <Icon id="bookmark-icon" glyph="bookmark" />
          <span id="bookmark-label">Save planet</span>
        </button>
      </div>
    </header>

    <article
      class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10"
      itemscope
      itemtype="https://schema.org/Planet"
    >
      <figure
        class="bg-background-200 border border-gray-300 rounded-xl flex items-center justify-center h-full"
      >
        <canvas
          id="planet-canvas"
          role="img"
          aria-label={`Visual representation of ${planet.name}`}
          width="200"
          height="200"
          data-type={planetType}
          data-radius={planet.radius_earth ?? 1}></canvas>
        <figcaption class="sr-only">Visual of {planet.name}</figcaption>
      </figure>

      <div class="flex flex-col justify-center">
        <div class="flex items-center justify-between gap-3 mb-2">
          <h1 class="font-medium text-primary text-heading-48" itemprop="name">
            {planet.name}
          </h1>
          <span
            class={`text-xs font-medium rounded-full py-1 px-2.5 ${typeStyles[planetType]}`}
          >
            {typeLabels[planetType]}
          </span>
        </div>
        <p class="font-mono text-sm text-gray-600 mb-6" itemprop="description">
          {planet.host_star}
          {
            planet.distance_ly && (
              <span> · {fmt(planet.distance_ly, 1)} ly</span>
            )
          }
          {planet.stellar_type && <span> · {planet.stellar_type}</span>}
        </p>

        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs text-gray-600">Habitability</span>
          <div class="flex-1 h-1.5 bg-gray-300 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full"
              style={`width:${planet.habitability_pct ?? 0}%;background:${habColor}`}
            >
            </div>
          </div>
          <span class="font-mono text-sm text-secondary"
            >{planet.habitability_pct ?? 0}%</span
          >
        </div>

        <dl class="grid grid-cols-2 gap-3">
          {
            [
              { label: "Radius", value: `${fmt(planet.radius_earth)}⊕` },
              { label: "Mass", value: `${fmt(planet.mass_earth)} M⊕` },
              { label: "Period", value: period },
              {
                label: "Temperature",
                value: `${fmt(planet.eq_temperature, 0)} K`,
              },
              { label: "ESI score", value: fmt(planet.esi_score, 3) },
              {
                label: "Discovered",
                value: planet.discovery_year?.toString() ?? "—",
              },
            ].map((measure) => (
              <div class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5">
                <dt class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]">
                  {measure.label}
                </dt>
                <dd class="font-mono text-sm text-primary">{measure.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </article>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <section class="bg-background-200 border border-gray-300 rounded-xl p-5">
        <h2
          class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
        >
          Transit Light Curve
        </h2>
        <canvas
          id="transit-canvas"
          role="img"
          aria-label="Transit light curve simulation"
          width="100%"
          height="90"
          style="width:100%;height:90px"></canvas>
      </section>

      <section class="bg-background-200 border border-gray-300 rounded-xl p-5">
        <div
          class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
        >
          Size comparison
        </div>
        <div id="size-compare" class="flex items-end justify-center gap-6 py-2">
        </div>
      </section>
    </div>

    <SkyMap
      rightAscension={planet.ra}
      declination={planet.dec}
      name={planet.name}
    />

    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        Could I live here?
      </h2>
      <div class="flex items-center gap-4 mb-4">
        <label class="text-sm text-gray-700 min-w-24">Your weight</label>
        <input
          type="range"
          id="weight-slider"
          min="30"
          max="200"
          value="70"
          step="1"
          class="flex-1 accent-green-500"
        />
        <span
          id="weight-out"
          class="font-mono text-sm text-secondary w-16 text-right">70 kg</span
        >
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-background-100 border border-gray-200 rounded-lg p-3">
          <h3
            class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
          >
            Weight here
          </h3>
          <div id="res-weight" class="font-mono text-sm text-primary">— kg</div>
        </div>
        <div class="bg-background-100 border border-gray-200 rounded-lg p-3">
          <h3
            class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
          >
            Year length
          </h3>
          <div class="font-mono text-sm text-primary">{period}</div>
        </div>
        <div class="bg-background-100 border border-gray-200 rounded-lg p-3">
          <h3
            class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
          >
            Surface gravity
          </h3>
          <div id="res-gravity" class="font-mono text-sm text-primary">— g</div>
        </div>
      </div>
    </section>

    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        Orbital period
      </h2>
      <div class="flex md:flex-row flex-col items-center justify-between gap-5">
        <div
          class="flex md:flex-col flex-row justify-between md:gap-4 h-full min-w-64"
        >
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-4 py-3 h-16"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              1 orbit takes
            </h3>
            <div id="orbit-period-label" class="font-mono text-sm text-primary">
              {period}
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-4 py-3 h-16"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Speed vs Earth
            </h3>
            <div id="orbit-speed-label" class="font-mono text-sm text-primary">
              —
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-4 py-3 h-16"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Your age there
            </h3>
            <div id="orbit-age-label" class="font-mono text-sm text-primary">
              —
            </div>
          </div>
        </div>
        <div class="w-full flex items-center justify-center">
          <canvas
            id="orbit-canvas"
            role="img"
            aria-label="Orbital period animation"
            width="260"
            height="224"></canvas>
        </div>
      </div>
    </section>
    <div class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="font-mono text-xs text-gray-600 uppercase tracking-widest">
          3D orbital view
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-gray-500"
            >drag to rotate · scroll to zoom</span
          >
          <button
            id="reset-camera"
            class="text-xs border border-gray-300 text-gray-600 px-3 py-1 rounded-lg hover:border-gray-500 transition-colors"
            >Reset</button
          >
        </div>
      </div>
      <div
        id="three-container"
        style="width:100%;height:380px;border-radius:8px;overflow:hidden;background:#000"
      >
      </div>
    </div>
    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        Host star
      </h2>
      <div class="flex items-center justify-between">
        <div class="w-full flex items-center justify-center">
          <canvas
            id="star-canvas"
            role="img"
            aria-label={`Host star ${planet.host_star} visualization`}
            width="120"
            height="120"></canvas>
        </div>
        <div class="grid grid-cols-2 gap-3 flex-1 min-w-135">
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Spectral type
            </h3>
            <div class="font-mono text-sm text-primary">
              {planet.stellar_type ?? "—"}
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Temperature
            </h3>
            <div class="font-mono text-sm text-primary">
              {
                planet.stellar_temp
                  ? `${Math.round(planet.stellar_temp).toLocaleString()} K`
                  : "—"
              }
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Star radius
            </h3>
            <div class="font-mono text-sm text-primary">
              {
                planet.stellar_radius
                  ? `${Number(planet.stellar_radius).toFixed(2)} R☉`
                  : "—"
              }
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <div
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Star name
            </div>
            <div class="font-mono text-sm text-primary">
              {planet.host_star}
            </div>
          </div>
        </div>
      </div>
    </section>
    {
      similarPlanets && similarPlanets.length > 0 && (
        <div class="my-8">
          <div class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4">
            Planets like this
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {similarPlanets.map((planet) => {
              const slug = planet.name.toLowerCase().replace(/\s+/g, "-");
              const habColor =
                (planet.habitability_pct ?? 0) >= 70
                  ? "var(--ds-green-600)"
                  : (planet.habitability_pct ?? 0) >= 40
                    ? "var(--ds-amber-600)"
                    : "var(--ds-red-600)";
              return (
                <a
                  href={`/planet/${slug}`}
                  class="bg-background-200 border border-gray-300 rounded-xl p-3 hover:border-gray-500 transition-colors block"
                >
                  <div class="text-xs font-medium text-gray-1000 mb-1 truncate">
                    {planet.name}
                  </div>
                  <div class="font-mono text-xs text-gray-600 mb-2 truncate">
                    {planet.host_star}
                  </div>
                  <div class="flex items-center gap-1.5">
                    <div class="flex-1 h-1 bg-gray-300 rounded-full overflow-hidden">
                      <div
                        class="h-full rounded-full"
                        style={`width:${planet.habitability_pct ?? 0}%;background:${habColor}`}
                      />
                    </div>
                    <span class="font-mono text-xs text-gray-600">
                      {planet.habitability_pct ?? 0}%
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )
    }

    <aside
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
      id="ai-summary-panel"
    >
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-mono text-xs text-gray-600 uppercase tracking-widest">
          AI overview
        </h2>
        <div id="ai-summary-loading" class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-green-600 animate-pulse">
          </div>
          <span class="font-mono text-xs text-gray-500">Generating...</span>
        </div>
      </div>
      <p
        id="ai-summary-text"
        class="text-sm text-gray-700 leading-relaxed"
        style="display:none"
      >
      </p>
    </aside>

    <aside class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6">
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        What if I lived there?
      </h2>
      <div id="ai-narrative-loading" class="flex items-center gap-2">
        <div
          class="w-2.5 h-2.5 rounded-full bg-purple-800 animate-pulse"
          style="width:6px;height:6px;border-radius:50%;background:var(--ds-purple-500);animation:pulse 1.5s infinite"
        >
        </div>
        <span class="font-mono text-xs text-gray-500"
          >Writing your story...</span
        >
      </div>
      <p
        id="ai-narrative-text"
        class="text-sm text-gray-700 leading-relaxed"
        style="display:none"
      >
      </p>
      <div
        class="font-mono text-xs text-right text-gray-600 tracking-widest flex items-center gap-2 justify-end mt-2"
      >
        <Icon glyph="warning" class="h-3 w-auto" /> AI generated
      </div>
    </aside>
  </section>
</Layout>

<script
  is:inline
  define:vars={{
    planetType,
    planetRadius: planet.radius_earth ?? 1,
    planetMass: planet.mass_earth ?? null,
    planetName: planet.name,
    planetPeriod: planet.orbital_period ?? 365,
    planetTemp: planet.eq_temperature ?? 255,
    stellarType: planet.stellar_type ?? null,
    stellarTemp: planet.stellar_temp ?? null,
    stellarRadius: planet.stellar_radius ?? 1,
    planetId: planet.id,
    hostStar: planet.host_star,
  }}
>
  const COLORS = {
    rocky: ["#8a7040", "#6a5030"],
    "super-earth": ["#3a9e75", "#1a7e55"],
    "sub-neptune": ["#4a8ed4", "#2a6eb4"],
    "neptune-like": ["#3a7ed4", "#1a5eb4"],
    "ocean-world": ["#3a7ed4", "#1a5eb4"],
    "hot-jupiter": ["#E87C1E", "#c85c0e"],
    "gas-giant": ["#8a5bc4", "#6a3ba4"],
    unknown: ["#505050", "#303030"],
  };

  const planetCanvas = document.getElementById("planet-canvas");
  const planetContext = planetCanvas.getContext("2d");
  const [color1, color2] = COLORS[planetType] ?? COLORS["unknown"];
  const size = 200,
    centerX = size / 2,
    centerY = size / 2;
  const radius = Math.min(Math.max(planetRadius * 22, 12), size * 0.44);
  const gradient = planetContext.createRadialGradient(
    centerX - radius * 0.3,
    centerY - radius * 0.3,
    radius * 0.1,
    centerX,
    centerY,
    radius,
  );
  gradient.addColorStop(0, color1);
  gradient.addColorStop(1, color2);
  planetContext.beginPath();
  planetContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
  planetContext.fillStyle = gradient;
  planetContext.fill();
  planetContext.beginPath();
  planetContext.arc(
    centerX - radius * 0.25,
    centerY - radius * 0.25,
    radius * 0.35,
    0,
    Math.PI * 2,
  );
  planetContext.fillStyle = "rgba(255,255,255,0.08)";
  planetContext.fill();

  const transitCanvas = document.getElementById("transit-canvas");
  transitCanvas.width = transitCanvas.offsetWidth || 400;
  const transitContext = transitCanvas.getContext("2d");
  const transitCanvasW = transitCanvas.width,
    transitCanvasH = 90;
  const MAX_TRANSIT_DIP = 30;
  const TRANSIT_SCALE_FACTOR = 3;
  const dip = Math.min(planetRadius * TRANSIT_SCALE_FACTOR, MAX_TRANSIT_DIP);

  transitContext.strokeStyle = "var(--ds-teal-500)";
  transitContext.lineWidth = 1.5;
  transitContext.beginPath();
  const transitPoints = [];
  for (let x = 0; x <= transitCanvasW; x++) {
    const t = x / transitCanvasW;
    const center = 0.5;
    const width = 0.12;
    let y = 20;
    if (Math.abs(t - center) < width) {
      const d = (t - center) / width;
      y += (dip * (1 - Math.cos(d * Math.PI))) / 2;
    }
    transitPoints.push([x, y]);
    x === 0 ? transitContext.moveTo(x, y) : transitContext.lineTo(x, y);
  }
  transitContext.stroke();

  transitContext.fillStyle = "var(--ds-gray-600)";
  transitContext.font = "10px monospace";
  transitContext.fillText("flux", 8, 16);
  transitContext.fillText("time →", transitCanvasW - 52, transitCanvasH - 6);
  transitContext.fillStyle = "var(--ds-teal-600)";
  transitContext.fillText(
    `−${((planetRadius ** 2 / 100) * 100).toFixed(2)}%`,
    transitCanvasW - 52,
    36,
  );

  let frame = 0;
  function animateTransit() {
    transitContext.clearRect(0, 0, transitCanvasW, transitCanvasH);
    transitContext.strokeStyle = "#14b8a6";
    transitContext.lineWidth = 1.5;
    transitContext.beginPath();
    transitPoints.forEach(([x, y], i) =>
      i === 0 ? transitContext.moveTo(x, y) : transitContext.lineTo(x, y),
    );
    transitContext.stroke();
    transitContext.fillStyle = "var(--ds-gray-600)";
    transitContext.font = "10px monospace";
    transitContext.fillText("flux", 8, 16);
    transitContext.fillText("time →", transitCanvasW - 52, transitCanvasH - 6);
    transitContext.fillStyle = "#14b8a6";
    transitContext.fillText(
      `−${((planetRadius ** 2 / 100) * 100).toFixed(2)}%`,
      transitCanvasW - 52,
      36,
    );
    const px = (frame / 120) * transitCanvasW;
    const py =
      transitPoints[Math.min(Math.floor(px), transitCanvasW - 1)]?.[1] ?? 20;
    transitContext.beginPath();
    transitContext.arc(px, py - 14, 4, 0, Math.PI * 2);
    transitContext.fillStyle = COLORS[planetType]?.[0] ?? "#888";
    transitContext.fill();
    frame = (frame + 1) % 120;
    requestAnimationFrame(animateTransit);
  }
  animateTransit();

  const orbitCanvas = document.getElementById("orbit-canvas");
  const orbitContext = orbitCanvas.getContext("2d");
  const orbitCanvasW = orbitCanvas.width,
    orbitCanvasH = orbitCanvas.height;
  const orbitCanvasX = orbitCanvasW / 2,
    orbitCanvasY = orbitCanvasH / 2;

  const earthOrbitR = 70;
  const planetOrbitR = Math.min(Math.max(earthOrbitR * 0.6, 40), 110);

  const earthPeriod = 365.25;
  const speedRatio = earthPeriod / (planetPeriod || 365.25);

  document.getElementById("orbit-speed-label").textContent =
    speedRatio > 1
      ? `${speedRatio.toFixed(1)}× faster`
      : `${(1 / speedRatio).toFixed(1)}× slower`;

  document.getElementById("orbit-age-label").textContent = planetPeriod
    ? `${((25 * earthPeriod) / planetPeriod).toFixed(1)} yrs`
    : "—";

  const [planetColor] = COLORS[planetType] ?? COLORS["unknown"];

  let earthAngle = 0;
  let planetAngle = 0;

  function drawOrbit() {
    orbitContext.clearRect(0, 0, orbitCanvasW, orbitCanvasH);

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, 10, 0, Math.PI * 2);
    orbitContext.fillStyle = "#ffd060";
    orbitContext.fill();

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, 14, 0, Math.PI * 2);
    orbitContext.fillStyle = "rgba(255,208,96,0.12)";
    orbitContext.fill();

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, earthOrbitR, 0, Math.PI * 2);
    orbitContext.strokeStyle = "rgba(255,255,255,0.08)";
    orbitContext.lineWidth = 1;
    orbitContext.stroke();

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, planetOrbitR, 0, Math.PI * 2);
    orbitContext.strokeStyle = "rgba(255,255,255,0.08)";
    orbitContext.lineWidth = 1;
    orbitContext.stroke();

    const earthX = orbitCanvasX + earthOrbitR * Math.cos(earthAngle);
    const earthY = orbitCanvasY + earthOrbitR * Math.sin(earthAngle);
    orbitContext.beginPath();
    orbitContext.arc(earthX, earthY, 5, 0, Math.PI * 2);
    orbitContext.fillStyle = "#378ADD";
    orbitContext.fill();

    orbitContext.fillStyle = "rgba(255,255,255,0.3)";
    orbitContext.font = "10px monospace";
    orbitContext.fillText("Earth", earthX + 7, earthY + 4);

    const planetX = orbitCanvasX + planetOrbitR * Math.cos(planetAngle);
    const planetY = orbitCanvasY + planetOrbitR * Math.sin(planetAngle);
    orbitContext.beginPath();
    orbitContext.arc(
      planetX,
      planetY,
      Math.min(Math.max(planetRadius * 2.5, 4), 10),
      0,
      Math.PI * 2,
    );
    orbitContext.fillStyle = planetColor;
    orbitContext.fill();

    orbitContext.fillStyle = "rgba(255,255,255,0.5)";
    orbitContext.font = "10px monospace";
    orbitContext.fillText(planetName.split(" ")[0], planetX + 8, planetY + 4);

    const baseSpeed = (2 * Math.PI) / 600;
    earthAngle += baseSpeed;
    planetAngle += baseSpeed * speedRatio;

    requestAnimationFrame(drawOrbit);
  }
  drawOrbit();

  function spectralToColor(type, temperature) {
    const temp = temperature ?? 5778;

    if (temp > 30000) return ["#9bb0ff", "#b0c0ff"];
    if (temp > 10000) return ["#aabfff", "#c0d0ff"];
    if (temp > 7500) return ["#f8f7ff", "#fffaf0"];
    if (temp > 6000) return ["#fff4e8", "#ffe8d0"];
    if (temp > 5200) return ["#ffdd90", "#ffd060"];
    if (temp > 3700) return ["#ffb347", "#ff8c00"];
    return ["#ff6b35", "#cc4400"];
  }

  function tempToSpectralClass(temperature) {
    if (!temperature) return null;
    if (temperature > 30000) return "O";
    if (temperature > 10000) return "B";
    if (temperature > 7500) return "A";
    if (temperature > 6000) return "F";
    if (temperature > 5200) return "G";
    if (temperature > 3700) return "K";
    return "M";
  }

  const displaySpectral =
    stellarType ?? tempToSpectralClass(stellarTemp) ?? "Unknown";

  const starCanvas = document.getElementById("star-canvas");
  const starContext = starCanvas.getContext("2d");
  const starCanvasW = starCanvas.width,
    starCanvasH = starCanvas.height;
  const starContextX = starCanvasW / 2,
    starContextY = starCanvasH / 2;

  starContext.fillStyle = "rgba(255,255,255,0.5)";
  starContext.font = "11px monospace";
  starContext.textAlign = "center";
  starContext.fillText(displaySpectral, starContextX, starCanvasH - 6);

  const [starColor1, starColor2] = spectralToColor(
    stellarType ?? tempToSpectralClass(stellarTemp),
    stellarTemp,
  );
  const starRadius = Math.min(
    Math.max((stellarRadius ?? 1) * 20, 18),
    starContextX - 8,
  );

  const starGradient = starContext.createRadialGradient(
    starContextX - starRadius * 0.3,
    starContextY - starRadius * 0.3,
    starRadius * 0.05,
    starContextX,
    starContextY,
    starRadius,
  );
  starGradient.addColorStop(0, starColor1);
  starGradient.addColorStop(0.6, starColor2);
  starGradient.addColorStop(1, starColor2 + "44");

  starContext.beginPath();
  starContext.arc(starContextX, starContextY, starRadius, 0, Math.PI * 2);
  starContext.fillStyle = starGradient;
  starContext.fill();

  starContext.beginPath();
  starContext.arc(starContextX, starContextY, starRadius + 6, 0, Math.PI * 2);
  starContext.fillStyle = starColor2 + "18";
  starContext.fill();

  const compare = document.getElementById("size-compare");
  const bodies = [
    { name: "Earth", radius: 1, color: "#378ADD" },
    {
      name: planetName.split(" ")[0],
      radius: Math.max(planetRadius, 0.1),
      color: COLORS[planetType]?.[0] ?? "#888",
    },
    { name: "Neptune", radius: 3.88, color: "#4a8ed4" },
    { name: "Jupiter", radius: 11.2, color: "#E87C1E" },
  ];
  const maxR = Math.max(...bodies.map((body) => body.radius));
  const scale = 44 / maxR;
  bodies.forEach((body) => {
    const px = Math.max(body.radius * scale, 5);
    const div = document.createElement("div");
    div.style.cssText =
      "display:flex;flex-direction:column;align-items:center;gap:8px";
    div.innerHTML = `
      <div style="width:${px * 2}px;height:${px * 2}px;border-radius:50%;background:${body.color};opacity:.85;flex-shrink:0"></div>
      <div style="font-size:10px;color:var(--ds-gray-600);font-family:var(--font-geist-mono);white-space:nowrap">${body.name}</div>
    `;
    compare.appendChild(div);
  });

  const estimatedMass = planetMass ?? Math.pow(planetRadius, 2.06);
  const gravityRatio = Math.max(estimatedMass / planetRadius ** 2, 0.01);
  const slider = document.getElementById("weight-slider");
  const weightOut = document.getElementById("weight-out");
  const resWeight = document.getElementById("res-weight");
  const resGravity = document.getElementById("res-gravity");

  function updateGravity() {
    const w = Number(slider.value);
    weightOut.textContent = `${w} kg`;
    resWeight.textContent = `${(w * gravityRatio).toFixed(1)} kg`;
    resGravity.textContent = `${gravityRatio.toFixed(2)} g`;
  }

  slider.addEventListener("input", updateGravity);
  updateGravity();

  const bmBtn = document.getElementById("bookmark-btn");
  const bmIcon = document.getElementById("bookmark-icon");
  const bmLabel = document.getElementById("bookmark-label");

  function updateBookmarkUI(saved) {
    if (saved) {
      bmBtn.style.borderColor = "var(--ds-green-500)";
      bmBtn.style.color = "var(--ds-green-600)";
      bmIcon.setAttribute("fill", "currentColor");
      bmLabel.textContent = "Saved";
    } else {
      bmBtn.style.borderColor = "";
      bmBtn.style.color = "";
      bmIcon.setAttribute("fill", "none");
      bmLabel.textContent = "Save planet";
    }
  }

  function getBookmarks() {
    try {
      return JSON.parse(localStorage.getItem("exoatlas:bookmarks") ?? "[]");
    } catch {
      return [];
    }
  }

  const planetData = JSON.parse(bmBtn.dataset.planet);

  updateBookmarkUI(getBookmarks().some((b) => b.id === planetData.id));

  bmBtn.addEventListener("click", () => {
    const list = getBookmarks();
    const already = list.some((bm) => bm.id === planetData.id);
    if (already) {
      localStorage.setItem(
        "exoatlas:bookmarks",
        JSON.stringify(list.filter((bm) => bm.id !== planetData.id)),
      );
      updateBookmarkUI(false);
    } else {
      list.unshift({ ...planetData, savedAt: new Date().toISOString() });
      localStorage.setItem("exoatlas:bookmarks", JSON.stringify(list));
      updateBookmarkUI(true);
    }
  });

  async function loadAISummary() {
    try {
      const response = await fetch(`/api/ai/summary?id=${planetId}`);
      const json = await response.json();
      if (json.summary) {
        document.getElementById("ai-summary-loading").style.display = "none";
        const summaryElement = document.getElementById("ai-summary-text");
        summaryElement.style.display = "block";
        summaryElement.textContent = json.summary;
      }
    } catch {
      document.getElementById("ai-summary-loading").style.display = "none";
    }
  }

  async function loadAINarrative() {
    try {
      const response = await fetch(`/api/ai/narrative?id=${planetId}`);
      const json = await response.json();
      if (json.narrative) {
        document.getElementById("ai-narrative-loading").style.display = "none";
        const narrativeElement = document.getElementById("ai-narrative-text");
        narrativeElement.style.display = "block";
        narrativeElement.textContent = json.narrative;
      }
    } catch {
      document.getElementById("ai-narrative-loading").style.display = "none";
    }
  }
  loadAISummary();
  loadAINarrative();

  const container = document.getElementById("three-container");

  const script3 = document.createElement("script");
  script3.src =
    "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js";
  script3.onload = () => init3D();
  document.head.appendChild(script3);

  function init3D() {
    const containerW = container.clientWidth;
    const containerH = container.clientHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      45,
      containerW / containerH,
      0.1,
      2000,
    );
    camera.position.set(0, 120, 220);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(containerW, containerH);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000, 1);
    container.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.15);
    scene.add(ambientLight);

    const sunLight = new THREE.PointLight(0xffd060, 2.5, 800);
    sunLight.position.set(0, 0, 0);
    scene.add(sunLight);

    function getStarColor(temp) {
      if (!temp) return 0xffd060;
      if (temp > 30000) return 0x9bb0ff;
      if (temp > 10000) return 0xaabfff;
      if (temp > 7500) return 0xf8f7ff;
      if (temp > 6000) return 0xfff4e8;
      if (temp > 5200) return 0xffdd90;
      if (temp > 3700) return 0xffb347;
      return 0xff6b35;
    }

    const starColor = getStarColor(stellarTemp);

    const starR = Math.min(Math.max((stellarRadius ?? 1) * 8, 8), 28);
    const starGeo = new THREE.SphereGeometry(starR, 32, 32);
    const starMaterial = new THREE.MeshStandardMaterial({
      color: starColor,
      emissive: starColor,
      emissiveIntensity: 0.8,
      roughness: 1,
    });
    const starMesh = new THREE.Mesh(starGeo, starMaterial);
    scene.add(starMesh);

    const glowGeo = new THREE.SphereGeometry(starR * 1.6, 16, 16);
    const glowMaterial = new THREE.MeshBasicMaterial({
      color: starColor,
      transparent: true,
      opacity: 0.08,
    });
    scene.add(new THREE.Mesh(glowGeo, glowMaterial));

    const starCount = 1200;
    const starPositions = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      starPositions[i * 3] = (Math.random() - 0.5) * 1800;
      starPositions[i * 3 + 1] = (Math.random() - 0.5) * 1800;
      starPositions[i * 3 + 2] = (Math.random() - 0.5) * 1800;
    }
    const starBgGeo = new THREE.BufferGeometry();
    starBgGeo.setAttribute(
      "position",
      new THREE.BufferAttribute(starPositions, 3),
    );
    const starBgMaterial = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.8,
      transparent: true,
      opacity: 0.6,
    });
    scene.add(new THREE.Points(starBgGeo, starBgMaterial));

    const PlanetColors = {
      rocky: 0x8a7040,
      "super-earth": 0x3a9e75,
      "sub-neptune": 0x4a8ed4,
      "neptune-like": 0x3a7ed4,
      "ocean-world": 0x3a7ed4,
      "hot-jupiter": 0xe87c1e,
      "gas-giant": 0x8a5bc4,
      unknown: 0x505050,
    };

    const orbitRadius = Math.max(starR * 2.2 + 20, 70);
    const planetR = Math.min(Math.max(planetRadius * 3.5, 3), 16);
    const planetColor = PlanetColors[planetType] ?? 0x505050;
    const orbitPoints = [];
    for (let i = 0; i <= 128; i++) {
      const a = (i / 128) * Math.PI * 2;
      orbitPoints.push(
        new THREE.Vector3(
          Math.cos(a) * orbitRadius,
          0,
          Math.sin(a) * orbitRadius,
        ),
      );
    }

    const orbitGeo = new THREE.BufferGeometry().setFromPoints(orbitPoints);
    const orbitMaterial = new THREE.LineBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.12,
    });
    scene.add(new THREE.Line(orbitGeo, orbitMaterial));

    // const gridHelper = new THREE.GridHelper(
    //   orbitRadius * 2.4,
    //   12,
    //   0x223344,
    //   0x111a22,
    // );
    // scene.add(gridHelper);

    const planetGeo = new THREE.SphereGeometry(planetR, 32, 32);
    const planetMaterial = new THREE.MeshStandardMaterial({
      color: planetColor,
      roughness: 0.8,
      metalness: 0.1,
    });
    const planetMesh = new THREE.Mesh(planetGeo, planetMaterial);
    scene.add(planetMesh);

    if (
      (planetType === "super-earth" || planetType === "rocky") &&
      planetRadius < 2
    ) {
      const hazeGeo = new THREE.SphereGeometry(planetR * 1.15, 16, 16);
      const hazeMat = new THREE.MeshBasicMaterial({
        color: 0x4a8ed4,
        transparent: true,
        opacity: 0.08,
      });
      const hazeMesh = new THREE.Mesh(hazeGeo, hazeMat);
      planetMesh.add(hazeMesh);
    }

    if (planetType === "gas-giant" || planetType === "hot-jupiter") {
      const ringGeo = new THREE.RingGeometry(planetR * 1.4, planetR * 2.2, 64);
      const ringMaterial = new THREE.MeshBasicMaterial({
        color: planetColor,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.25,
      });

      const ringMesh = new THREE.Mesh(ringGeo, ringMaterial);
      ringMesh.rotation.x = Math.PI / 3;
      planetMesh.add(ringMesh);
    }

    const baseSpeed = 0.008;
    const speedRatio = 365.25 / (planetPeriod || 365.25);
    const orbSpeed = Math.min(
      Math.max(baseSpeed * Math.sqrt(speedRatio), 0.002),
      0.04,
    );

    let angle = 0;
    let paused = false;

    function animate() {
      animId = requestAnimationFrame(animate);
      if (!paused) {
        angle += orbSpeed;
        planetMesh.position.x = Math.cos(angle) * orbitRadius;
        planetMesh.position.z = Math.sin(angle) * orbitRadius;
        planetMesh.rotation.y += 0.005;
      }
      controls.update();
      renderer.render(scene, camera);
    }

    const controls = {
      isDragging: false,
      lastX: 0,
      lastY: 0,
      theta: 0.4,
      phi: 1.1,
      radius: 260,
      update() {
        camera.position.x =
          this.radius * Math.sin(this.phi) * Math.sin(this.theta);
        camera.position.y = this.radius * Math.cos(this.phi);
        camera.position.z =
          this.radius * Math.sin(this.phi) * Math.cos(this.theta);
        camera.lookAt(0, 0, 0);
      },
    };

    renderer.domElement.addEventListener("mousedown", (e) => {
      controls.isDragging = true;
      controls.lastX = e.clientX;
      controls.lastY = e.clientY;
    });
    renderer.domElement.addEventListener("mousemove", (e) => {
      if (!controls.isDragging) return;
      const dx = e.clientX - controls.lastX;
      const dy = e.clientY - controls.lastY;
      controls.theta -= dx * 0.008;
      controls.phi = Math.max(
        0.2,
        Math.min(Math.PI - 0.2, controls.phi + dy * 0.008),
      );
      controls.lastX = e.clientX;
      controls.lastY = e.clientY;
    });
    renderer.domElement.addEventListener("mouseup", () => {
      controls.isDragging = false;
    });
    renderer.domElement.addEventListener("mouseleave", () => {
      controls.isDragging = false;
    });
    renderer.domElement.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        controls.radius = Math.max(
          60,
          Math.min(500, controls.radius + e.deltaY * 0.3),
        );
      },
      { passive: false },
    );

    let lastTouchDist = 0;
    renderer.domElement.addEventListener("touchstart", (e) => {
      if (e.touches.length === 1) {
        controls.isDragging = true;
        controls.lastX = e.touches[0].clientX;
        controls.lastY = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        lastTouchDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );
      }
    });
    renderer.domElement.addEventListener(
      "touchmove",
      (e) => {
        e.preventDefault();
        if (e.touches.length === 1 && controls.isDragging) {
          const dx = e.touches[0].clientX - controls.lastX;
          const dy = e.touches[0].clientY - controls.lastY;
          controls.theta -= dx * 0.008;
          controls.phi = Math.max(
            0.2,
            Math.min(Math.PI - 0.2, controls.phi + dy * 0.008),
          );
          controls.lastX = e.touches[0].clientX;
          controls.lastY = e.touches[0].clientY;
        } else if (e.touches.length === 2) {
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY,
          );
          controls.radius = Math.max(
            60,
            Math.min(500, controls.radius - (dist - lastTouchDist) * 0.5),
          );
          lastTouchDist = dist;
        }
      },
      { passive: false },
    );
    renderer.domElement.addEventListener("touchend", () => {
      controls.isDragging = false;
    });

    renderer.domElement.addEventListener("click", () => {
      paused = !paused;
    });

    document.getElementById("reset-camera")?.addEventListener("click", () => {
      controls.theta = 0.4;
      controls.phi = 1.1;
      controls.radius = 260;
      paused = false;
    });

    window.addEventListener("resize", () => {
      const contW = container.clientWidth;
      const contH = container.clientHeight;
      camera.aspect = contW / contH;
      camera.updateProjectionMatrix();
      renderer.setSize(contW, contH);
    });
    const label = document.createElement("div");
    label.style.cssText =
      "position:absolute;bottom:12px;left:16px;font-family:var(--font-geist-mono);font-size:10px;color:rgba(255,255,255,0.4);pointer-events:none;line-height:1.6";
    label.innerHTML = `${planetName} orbiting ${hostStar}<br>1 orbit = ${
      planetPeriod < 1
        ? `${(planetPeriod * 24).toFixed(1)}h`
        : planetPeriod > 1000
          ? `${(planetPeriod / 365.25).toFixed(1)}yr`
          : `${planetPeriod.toFixed(1)}d`
    } · click to pause`;
    container.style.position = "relative";
    container.appendChild(label);
    controls.update();
    animate();
  }
</script>
