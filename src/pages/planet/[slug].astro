---
import Layout from "@/layouts/base.astro";
import Icon from "@/components/icons.astro";
import SkyMap from "@/components/skyMap.astro";
import { supabase } from "@/lib/supabase";

export const prerender = false;

const { slug } = Astro.params;
const ogImage = `${Astro.site ?? ""}/og/${slug}.png`;

const { data: planet } = await supabase
  .rpc("get_planet_by_slug", { p_name: slug ?? "" })
  .single();

if (!planet) return Astro.redirect("/atlas");

const fmt = (v: number | null, d = 2) =>
  v != null ? Number(v).toFixed(d) : "—";

const period =
  planet.orbital_period == null
    ? "—"
    : planet.orbital_period < 1
      ? `${(planet.orbital_period * 24).toFixed(1)}h`
      : planet.orbital_period > 1000
        ? `${(planet.orbital_period / 365.25).toFixed(1)} yr`
        : `${planet.orbital_period.toFixed(1)} days`;

const typeLabels: Record<string, string> = {
  rocky: "Rocky",
  "super-earth": "Super-earth",
  "sub-neptune": "Sub-neptune",
  "neptune-like": "Neptune-like",
  "ocean-world": "Ocean world",
  "hot-jupiter": "Hot Jupiter",
  "gas-giant": "Gas giant",
  unknown: "Unknown",
};

const typeStyles: Record<string, string> = {
  rocky: "bg-amber-100 text-amber-500",
  "super-earth": "bg-teal-200 text-teal-800",
  "sub-neptune": "bg-blue-200 text-blue-800",
  "neptune-like": "bg-blue-200 text-blue-800",
  "ocean-world": "bg-blue-200 text-blue-800",
  "hot-jupiter": "bg-amber-200 text-amber-800",
  "gas-giant": "bg-purple-200 text-purple-800",
  unknown: "bg-gray-200 text-gray-700",
};

const habColor =
  (planet.habitability_pct ?? 0) >= 70
    ? "var(--ds-green-600)"
    : (planet.habitability_pct ?? 0) >= 40
      ? "var(--ds-amber-600)"
      : "var(--ds-red-600)";

const planetType = planet.planet_type ?? "unknown";

const { data: similarPlanets } = await supabase.rpc("get_similar_planets", {
  p_planet_id: planet.id,
  p_limit: 4,
});
---

<Layout
  title={`${planet.name} — Exoplanet Atlas`}
  description={`${planet.name} is a ${planet.planet_type} orbiting ${planet.host_star}, ${planet.distance_ly ? `${Number(planet.distance_ly).toFixed(1)} light-years away.` : "discovered via " + planet.discovery_method + "."}`}
  ogImage={ogImage}
  ogType="article"
>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <header class="mb-8 flex items-baseline justify-between">
      <nav aria-label="Breadcrumb">
        <a
          href="/atlas"
          rel="up"
          class="text-md text-gray-600 hover:text-secondary transition-colors flex gap-1 items-center group"
          ><Icon
            glyph="arrow-left"
            class="group-hover:-translate-x-2 group-hover:scale-110 transition-all duration-300"
          />Atlas</a
        >
      </nav>
      <div class="flex items-center gap-3 mt-4">
        <button
          id="bookmark-btn"
          type="button"
          aria-label="Save planet to local collection"
          data-planet={JSON.stringify({
            id: planet.id,
            name: planet.name,
            host_star: planet.host_star,
            planet_type: planet.planet_type,
            habitability_pct: planet.habitability_pct,
            radius_earth: planet.radius_earth,
            discovery_year: planet.discovery_year,
          })}
          class="flex items-center gap-2 text-xs border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:border-gray-500 transition-colors"
        >
          <Icon id="bookmark-icon" glyph="bookmark" />
          <span id="bookmark-label">Save planet</span>
        </button>
        <button
          id="share-btn"
          class="flex items-center gap-2 text-xs border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:border-gray-500 transition-colors"
        >
          <Icon glyph="share-alt" />
          Share card
        </button>
        <button
          id="compare-btn"
          class="flex items-center gap-2 text-xs border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:border-gray-500 transition-colors"
        >
          <Icon  glyph="function-square" />
          Compare
        </button>

        <div
          id="compare-modal"
          style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center"
        >
          <div
            style="background:var(--ds-background-100);border:0.5px solid var(--ds-gray-300);border-radius:16px;padding:28px;width:min(480px,90vw)"
          >
            <div
              style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px"
            >
              <div
                style="font-family:var(--font-geist-mono);font-size:12px;color:var(--ds-gray-600);text-transform:uppercase;letter-spacing:.08em"
              >
                Compare with...
              </div>
              <button
                id="close-compare-modal"
                style="color:var(--ds-gray-600);background:none;border:none;cursor:pointer;font-size:16px"
                >✕</button
              >
            </div>
            <input
              id="compare-search-input"
              type="text"
              placeholder="Search planet name..."
              style="width:100%;background:var(--ds-background-200);border:0.5px solid var(--ds-gray-300);border-radius:8px;padding:10px 14px;font-size:13px;color:var(--primary);outline:none;margin-bottom:10px"
            />
            <div
              id="compare-results"
              style="max-height:280px;overflow-y:auto;display:flex;flex-direction:column;gap:4px"
            >
            </div>
          </div>
        </div>
      </div>
    </header>

    <article
      class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10"
      itemscope
      itemtype="https://schema.org/Planet"
    >
      <figure
        class="bg-background-200 border border-gray-300 rounded-xl flex items-center justify-center h-full"
      >
        <canvas
          id="planet-canvas"
          role="img"
          aria-label={`Visual representation of ${planet.name}`}
          width="200"
          height="200"
          data-type={planetType}
          data-radius={planet.radius_earth ?? 1}></canvas>
        <figcaption class="sr-only">Visual of {planet.name}</figcaption>
      </figure>

      <div class="flex flex-col justify-center">
        <div class="flex items-center justify-between gap-3 mb-2">
          <h1 class="font-medium text-primary text-heading-48" itemprop="name">
            {planet.name}
          </h1>
          <span
            class={`text-xs font-medium rounded-full py-1 px-2.5 ${typeStyles[planetType]}`}
          >
            {typeLabels[planetType]}
          </span>
        </div>
        <p class="font-mono text-sm text-gray-600 mb-6" itemprop="description">
          {planet.host_star}
          {
            planet.distance_ly && (
              <span> · {fmt(planet.distance_ly, 1)} ly</span>
            )
          }
          {planet.stellar_type && <span> · {planet.stellar_type}</span>}
        </p>

        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs text-gray-600">Habitability</span>
          <div class="flex-1 h-1.5 bg-gray-300 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full"
              style={`width:${planet.habitability_pct ?? 0}%;background:${habColor}`}
            >
            </div>
          </div>
          <span class="font-mono text-sm text-secondary"
            >{planet.habitability_pct ?? 0}%</span
          >
        </div>

        <dl class="grid grid-cols-2 gap-3">
          {
            [
              { label: "Radius", value: `${fmt(planet.radius_earth)}⊕` },
              { label: "Mass", value: `${fmt(planet.mass_earth)} M⊕` },
              { label: "Period", value: period },
              {
                label: "Temperature",
                value: `${fmt(planet.eq_temperature, 0)} K`,
              },
              { label: "ESI score", value: fmt(planet.esi_score, 3) },
              {
                label: "Discovered",
                value: planet.discovery_year?.toString() ?? "—",
              },
            ].map((measure) => (
              <div class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5">
                <dt class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]">
                  {measure.label}
                </dt>
                <dd class="font-mono text-sm text-primary">{measure.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </article>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <section class="bg-background-200 border border-gray-300 rounded-xl p-5">
        <h2
          class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
        >
          Transit Light Curve
        </h2>
        <canvas
          id="transit-canvas"
          role="img"
          aria-label="Transit light curve simulation"
          width="100%"
          height="90"
          style="width:100%;height:90px"></canvas>
      </section>

      <section class="bg-background-200 border border-gray-300 rounded-xl p-5">
        <div
          class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
        >
          Size comparison
        </div>
        <div id="size-compare" class="flex items-end justify-center gap-6 py-2">
        </div>
      </section>
    </div>

    <SkyMap
      rightAscension={planet.ra}
      declination={planet.dec}
      name={planet.name}
    />

    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        Could I live here?
      </h2>
      <div class="flex items-center gap-4 mb-4">
        <label class="text-sm text-gray-700 min-w-24">Your weight</label>
        <input
          type="range"
          id="weight-slider"
          min="30"
          max="200"
          value="70"
          step="1"
          class="flex-1 accent-green-500"
        />
        <span
          id="weight-out"
          class="font-mono text-sm text-secondary w-16 text-right">70 kg</span
        >
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-background-100 border border-gray-200 rounded-lg p-3">
          <h3
            class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
          >
            Weight here
          </h3>
          <div id="res-weight" class="font-mono text-sm text-primary">— kg</div>
        </div>
        <div class="bg-background-100 border border-gray-200 rounded-lg p-3">
          <h3
            class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
          >
            Year length
          </h3>
          <div class="font-mono text-sm text-primary">{period}</div>
        </div>
        <div class="bg-background-100 border border-gray-200 rounded-lg p-3">
          <h3
            class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
          >
            Surface gravity
          </h3>
          <div id="res-gravity" class="font-mono text-sm text-primary">— g</div>
        </div>
      </div>
    </section>
    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <div class="flex items-center justify-between mb-4">
        <div class="font-mono text-xs text-gray-600 uppercase tracking-widest">
          Habitable zone
        </div>
        <span
          id="hz-badge"
          class="font-mono text-xs px-3 py-1 rounded-full border"
          style="border-color:var(--ds-gray-400);color:var(--ds-gray-600)"
        >
          Calculating...
        </span>
      </div>
      <canvas
        id="hz-canvas"
        height="150"
        style="width:100%;height:150px"
        role="img"
        aria-label={`Habitable zone diagram for ${planet.name}`}></canvas>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
        <div
          class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
        >
          <div
            style="font-size:10px;text-transform:uppercase;letter-spacing:.07em"
            class="text-gray-500 mb-1"
          >
            Luminosity
          </div>
          <div id="hz-luminosity" class="font-mono text-sm text-primary">—</div>
        </div>
        <div
          class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
        >
          <div
            style="font-size:10px;text-transform:uppercase;letter-spacing:.07em"
            class="text-gray-500 mb-1"
          >
            Planet distance
          </div>
          <div id="hz-planet-au" class="font-mono text-sm text-primary">—</div>
        </div>
        <div
          class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
        >
          <div
            style="font-size:10px;text-transform:uppercase;letter-spacing:.07em"
            class="text-gray-500 mb-1"
          >
            HZ inner edge
          </div>
          <div id="hz-inner" class="font-mono text-sm text-primary">—</div>
        </div>
        <div
          class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
        >
          <div
            style="font-size:10px;text-transform:uppercase;letter-spacing:.07em"
            class="text-gray-500 mb-1"
          >
            HZ outer edge
          </div>
          <div id="hz-outer" class="font-mono text-sm text-primary">—</div>
        </div>
      </div>
    </section>
    <div class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="font-mono text-xs text-gray-600 uppercase tracking-widest">
          Atmosphere
        </div>
        <div class="flex items-center gap-2">
          <span
            id="atm-badge"
            class="text-xs px-3 py-1 rounded-full border"
            style="border-color:var(--ds-gray-400);color:var(--ds-gray-600)"
          >
            —
          </span>
          <span
            id="atm-breathable"
            class="text-xs px-3 py-1 rounded-full"
            style="display:none"
          >
          </span>
        </div>
      </div>

      <p
        id="atm-description"
        class="text-sm text-gray-600 leading-relaxed mb-5"
      >
      </p>

      <div class="grid grid-cols-2 gap-3 mb-5">
        <div
          class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
        >
          <div
            style="font-size:10px;text-transform:uppercase;letter-spacing:.07em"
            class="text-gray-500 mb-1"
          >
            Surface pressure
          </div>
          <div id="atm-pressure" class="font-mono text-sm text-primary">—</div>
        </div>
        <div
          class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
        >
          <div
            style="font-size:10px;text-transform:uppercase;letter-spacing:.07em"
            class="text-gray-500 mb-1"
          >
            Breathable
          </div>
          <div id="atm-breathable-stat" class="font-mono text-sm text-primary">
            —
          </div>
        </div>
      </div>

      <div
        class="font-mono text-xs text-gray-500 uppercase tracking-widest mb-3"
      >
        Estimated composition
      </div>
      <div id="atm-composition" class="space-y-2"></div>
    </div>
    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        Orbital period
      </h2>
      <div class="flex md:flex-row flex-col items-center justify-between gap-5">
        <div
          class="flex md:flex-col flex-row justify-between md:gap-4 h-full min-w-64"
        >
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-4 py-3 h-16"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              1 orbit takes
            </h3>
            <div id="orbit-period-label" class="font-mono text-sm text-primary">
              {period}
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-4 py-3 h-16"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Speed vs Earth
            </h3>
            <div id="orbit-speed-label" class="font-mono text-sm text-primary">
              —
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-4 py-3 h-16"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Your age there
            </h3>
            <div id="orbit-age-label" class="font-mono text-sm text-primary">
              —
            </div>
          </div>
        </div>
        <div class="w-full flex items-center justify-center">
          <canvas
            id="orbit-canvas"
            role="img"
            aria-label="Orbital period animation"
            width="260"
            height="224"></canvas>
        </div>
      </div>
    </section>
    <div class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="font-mono text-xs text-gray-600 uppercase tracking-widest">
          3D orbital view
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-gray-500"
            >drag to rotate · scroll to zoom</span
          >
          <button
            id="reset-camera"
            class="text-xs border border-gray-300 text-gray-600 px-3 py-1 rounded-lg hover:border-gray-500 transition-colors"
            >Reset</button
          >
        </div>
      </div>
      <div
        id="three-container"
        style="width:100%;height:380px;border-radius:8px;overflow:hidden;background:#000"
      >
      </div>
    </div>
    <section
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
    >
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        Host star
      </h2>
      <div class="flex items-center justify-between">
        <div class="w-full flex items-center justify-center">
          <canvas
            id="star-canvas"
            role="img"
            aria-label={`Host star ${planet.host_star} visualization`}
            width="120"
            height="120"></canvas>
        </div>
        <div class="grid grid-cols-2 gap-3 flex-1 min-w-135">
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Spectral type
            </h3>
            <div class="font-mono text-sm text-primary">
              {planet.stellar_type ?? "—"}
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Temperature
            </h3>
            <div class="font-mono text-sm text-primary">
              {
                planet.stellar_temp
                  ? `${Math.round(planet.stellar_temp).toLocaleString()} K`
                  : "—"
              }
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <h3
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Star radius
            </h3>
            <div class="font-mono text-sm text-primary">
              {
                planet.stellar_radius
                  ? `${Number(planet.stellar_radius).toFixed(2)} R☉`
                  : "—"
              }
            </div>
          </div>
          <div
            class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5"
          >
            <div
              class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]"
            >
              Star name
            </div>
            <div class="font-mono text-sm text-primary">
              {planet.host_star}
            </div>
          </div>
        </div>
      </div>
    </section>
    {
      similarPlanets && similarPlanets.length > 0 && (
        <div class="my-8">
          <div class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4">
            Planets like this
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {similarPlanets.map((planet) => {
              const slug = planet.name.toLowerCase().replace(/\s+/g, "-");
              const habColor =
                (planet.habitability_pct ?? 0) >= 70
                  ? "var(--ds-green-600)"
                  : (planet.habitability_pct ?? 0) >= 40
                    ? "var(--ds-amber-600)"
                    : "var(--ds-red-600)";
              return (
                <a
                  href={`/planet/${slug}`}
                  class="bg-background-200 border border-gray-300 rounded-xl p-3 hover:border-gray-500 transition-colors block"
                >
                  <div class="text-xs font-medium text-primary mb-1 truncate">
                    {planet.name}
                  </div>
                  <div class="font-mono text-xs text-gray-600 mb-2 truncate">
                    {planet.host_star}
                  </div>
                  <div class="flex items-center gap-1.5">
                    <div class="flex-1 h-1 bg-gray-300 rounded-full overflow-hidden">
                      <div
                        class="h-full rounded-full"
                        style={`width:${planet.habitability_pct ?? 0}%;background:${habColor}`}
                      />
                    </div>
                    <span class="font-mono text-xs text-gray-600">
                      {planet.habitability_pct ?? 0}%
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )
    }

    <aside
      class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6"
      id="ai-summary-panel"
    >
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-mono text-xs text-gray-600 uppercase tracking-widest">
          AI overview
        </h2>
        <div id="ai-summary-loading" class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-green-600 animate-pulse">
          </div>
          <span class="font-mono text-xs text-gray-500">Generating...</span>
        </div>
      </div>
      <p
        id="ai-summary-text"
        class="text-sm text-gray-700 leading-relaxed"
        style="display:none"
      >
      </p>
    </aside>

    <aside class="bg-background-200 border border-gray-300 rounded-xl p-5 mb-6">
      <h2
        class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-4"
      >
        What if I lived there?
      </h2>
      <div id="ai-narrative-loading" class="flex items-center gap-2">
        <div
          class="w-2.5 h-2.5 rounded-full bg-purple-800 animate-pulse"
          style="width:6px;height:6px;border-radius:50%;background:var(--ds-purple-500);animation:pulse 1.5s infinite"
        >
        </div>
        <span class="font-mono text-xs text-gray-500"
          >Writing your story...</span
        >
      </div>
      <p
        id="ai-narrative-text"
        class="text-sm text-gray-700 leading-relaxed"
        style="display:none"
      >
      </p>
      <div
        class="font-mono text-xs text-right text-gray-600 tracking-widest flex items-center gap-2 justify-end mt-2"
      >
        <Icon glyph="warning" class="h-3 w-auto" /> AI generated
      </div>
    </aside>
  </section>
</Layout>

<script
  is:inline
  define:vars={{
    planetType,
    planetRadius: planet.radius_earth ?? 1,
    planetMass: planet.mass_earth ?? null,
    planetName: planet.name,
    planetPeriod: planet.orbital_period ?? 365,
    planetTemp: planet.eq_temperature ?? 255,
    stellarType: planet.stellar_type ?? null,
    stellarTemp: planet.stellar_temp ?? null,
    stellarRadius: planet.stellar_radius ?? 1,
    planetId: planet.id,
    hostStar: planet.host_star,
    planetEsi: planet.esi_score ?? null,
    planetHabPct: planet.habitability_pct ?? null,
    planetDistanceLy: planet.distance_ly ?? null,
    planetSlug: slug,
  }}
>
  const COLORS = {
    rocky: ["#8a7040", "#6a5030"],
    "super-earth": ["#3a9e75", "#1a7e55"],
    "sub-neptune": ["#4a8ed4", "#2a6eb4"],
    "neptune-like": ["#3a7ed4", "#1a5eb4"],
    "ocean-world": ["#3a7ed4", "#1a5eb4"],
    "hot-jupiter": ["#E87C1E", "#c85c0e"],
    "gas-giant": ["#8a5bc4", "#6a3ba4"],
    unknown: ["#505050", "#303030"],
  };

  const planetCanvas = document.getElementById("planet-canvas");
  const planetContext = planetCanvas.getContext("2d");
  const [color1, color2] = COLORS[planetType] ?? COLORS["unknown"];
  const size = 200,
    centerX = size / 2,
    centerY = size / 2;
  const radius = Math.min(Math.max(planetRadius * 22, 12), size * 0.44);
  const gradient = planetContext.createRadialGradient(
    centerX - radius * 0.3,
    centerY - radius * 0.3,
    radius * 0.1,
    centerX,
    centerY,
    radius,
  );
  gradient.addColorStop(0, color1);
  gradient.addColorStop(1, color2);
  planetContext.beginPath();
  planetContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
  planetContext.fillStyle = gradient;
  planetContext.fill();
  planetContext.beginPath();
  planetContext.arc(
    centerX - radius * 0.25,
    centerY - radius * 0.25,
    radius * 0.35,
    0,
    Math.PI * 2,
  );
  planetContext.fillStyle = "rgba(255,255,255,0.08)";
  planetContext.fill();

  const transitCanvas = document.getElementById("transit-canvas");
  transitCanvas.width = transitCanvas.offsetWidth || 400;
  const transitContext = transitCanvas.getContext("2d");
  const transitCanvasW = transitCanvas.width,
    transitCanvasH = 90;
  const MAX_TRANSIT_DIP = 30;
  const TRANSIT_SCALE_FACTOR = 3;
  const dip = Math.min(planetRadius * TRANSIT_SCALE_FACTOR, MAX_TRANSIT_DIP);

  transitContext.strokeStyle = "var(--ds-teal-500)";
  transitContext.lineWidth = 1.5;
  transitContext.beginPath();
  const transitPoints = [];
  for (let x = 0; x <= transitCanvasW; x++) {
    const t = x / transitCanvasW;
    const center = 0.5;
    const width = 0.12;
    let y = 20;
    if (Math.abs(t - center) < width) {
      const d = (t - center) / width;
      y += (dip * (1 - Math.cos(d * Math.PI))) / 2;
    }
    transitPoints.push([x, y]);
    x === 0 ? transitContext.moveTo(x, y) : transitContext.lineTo(x, y);
  }
  transitContext.stroke();

  transitContext.fillStyle = "var(--ds-gray-600)";
  transitContext.font = "10px monospace";
  transitContext.fillText("flux", 8, 16);
  transitContext.fillText("time →", transitCanvasW - 52, transitCanvasH - 6);
  transitContext.fillStyle = "var(--ds-teal-600)";
  transitContext.fillText(
    `−${((planetRadius ** 2 / 100) * 100).toFixed(2)}%`,
    transitCanvasW - 52,
    36,
  );

  let frame = 0;
  function animateTransit() {
    transitContext.clearRect(0, 0, transitCanvasW, transitCanvasH);
    transitContext.strokeStyle = "#14b8a6";
    transitContext.lineWidth = 1.5;
    transitContext.beginPath();
    transitPoints.forEach(([x, y], i) =>
      i === 0 ? transitContext.moveTo(x, y) : transitContext.lineTo(x, y),
    );
    transitContext.stroke();
    transitContext.fillStyle = "var(--ds-gray-600)";
    transitContext.font = "10px monospace";
    transitContext.fillText("flux", 8, 16);
    transitContext.fillText("time →", transitCanvasW - 52, transitCanvasH - 6);
    transitContext.fillStyle = "#14b8a6";
    transitContext.fillText(
      `−${((planetRadius ** 2 / 100) * 100).toFixed(2)}%`,
      transitCanvasW - 52,
      36,
    );
    const px = (frame / 120) * transitCanvasW;
    const py =
      transitPoints[Math.min(Math.floor(px), transitCanvasW - 1)]?.[1] ?? 20;
    transitContext.beginPath();
    transitContext.arc(px, py - 14, 4, 0, Math.PI * 2);
    transitContext.fillStyle = COLORS[planetType]?.[0] ?? "#888";
    transitContext.fill();
    frame = (frame + 1) % 120;
    requestAnimationFrame(animateTransit);
  }
  animateTransit();

  const orbitCanvas = document.getElementById("orbit-canvas");
  const orbitContext = orbitCanvas.getContext("2d");
  const orbitCanvasW = orbitCanvas.width,
    orbitCanvasH = orbitCanvas.height;
  const orbitCanvasX = orbitCanvasW / 2,
    orbitCanvasY = orbitCanvasH / 2;

  const earthOrbitR = 70;
  const planetOrbitR = Math.min(Math.max(earthOrbitR * 0.6, 40), 110);

  const earthPeriod = 365.25;
  const speedRatio = earthPeriod / (planetPeriod || 365.25);

  document.getElementById("orbit-speed-label").textContent =
    speedRatio > 1
      ? `${speedRatio.toFixed(1)}× faster`
      : `${(1 / speedRatio).toFixed(1)}× slower`;

  document.getElementById("orbit-age-label").textContent = planetPeriod
    ? `${((25 * earthPeriod) / planetPeriod).toFixed(1)} yrs`
    : "—";

  const [planetColor] = COLORS[planetType] ?? COLORS["unknown"];

  let earthAngle = 0;
  let planetAngle = 0;

  function drawOrbit() {
    orbitContext.clearRect(0, 0, orbitCanvasW, orbitCanvasH);

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, 10, 0, Math.PI * 2);
    orbitContext.fillStyle = "#ffd060";
    orbitContext.fill();

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, 14, 0, Math.PI * 2);
    orbitContext.fillStyle = "rgba(255,208,96,0.12)";
    orbitContext.fill();

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, earthOrbitR, 0, Math.PI * 2);
    orbitContext.strokeStyle = "rgba(255,255,255,0.08)";
    orbitContext.lineWidth = 1;
    orbitContext.stroke();

    orbitContext.beginPath();
    orbitContext.arc(orbitCanvasX, orbitCanvasY, planetOrbitR, 0, Math.PI * 2);
    orbitContext.strokeStyle = "rgba(255,255,255,0.08)";
    orbitContext.lineWidth = 1;
    orbitContext.stroke();

    const earthX = orbitCanvasX + earthOrbitR * Math.cos(earthAngle);
    const earthY = orbitCanvasY + earthOrbitR * Math.sin(earthAngle);
    orbitContext.beginPath();
    orbitContext.arc(earthX, earthY, 5, 0, Math.PI * 2);
    orbitContext.fillStyle = "#378ADD";
    orbitContext.fill();

    orbitContext.fillStyle = "rgba(255,255,255,0.3)";
    orbitContext.font = "10px monospace";
    orbitContext.fillText("Earth", earthX + 7, earthY + 4);

    const planetX = orbitCanvasX + planetOrbitR * Math.cos(planetAngle);
    const planetY = orbitCanvasY + planetOrbitR * Math.sin(planetAngle);
    orbitContext.beginPath();
    orbitContext.arc(
      planetX,
      planetY,
      Math.min(Math.max(planetRadius * 2.5, 4), 10),
      0,
      Math.PI * 2,
    );
    orbitContext.fillStyle = planetColor;
    orbitContext.fill();

    orbitContext.fillStyle = "rgba(255,255,255,0.5)";
    orbitContext.font = "10px monospace";
    orbitContext.fillText(planetName.split(" ")[0], planetX + 8, planetY + 4);

    const baseSpeed = (2 * Math.PI) / 600;
    earthAngle += baseSpeed;
    planetAngle += baseSpeed * speedRatio;

    requestAnimationFrame(drawOrbit);
  }
  drawOrbit();

  function spectralToColor(type, temperature) {
    const temp = temperature ?? 5778;

    if (temp > 30000) return ["#9bb0ff", "#b0c0ff"];
    if (temp > 10000) return ["#aabfff", "#c0d0ff"];
    if (temp > 7500) return ["#f8f7ff", "#fffaf0"];
    if (temp > 6000) return ["#fff4e8", "#ffe8d0"];
    if (temp > 5200) return ["#ffdd90", "#ffd060"];
    if (temp > 3700) return ["#ffb347", "#ff8c00"];
    return ["#ff6b35", "#cc4400"];
  }

  function tempToSpectralClass(temperature) {
    if (!temperature) return null;
    if (temperature > 30000) return "O";
    if (temperature > 10000) return "B";
    if (temperature > 7500) return "A";
    if (temperature > 6000) return "F";
    if (temperature > 5200) return "G";
    if (temperature > 3700) return "K";
    return "M";
  }

  const displaySpectral =
    stellarType ?? tempToSpectralClass(stellarTemp) ?? "Unknown";

  const starCanvas = document.getElementById("star-canvas");
  const starContext = starCanvas.getContext("2d");
  const starCanvasW = starCanvas.width,
    starCanvasH = starCanvas.height;
  const starContextX = starCanvasW / 2,
    starContextY = starCanvasH / 2;

  starContext.fillStyle = "rgba(255,255,255,0.5)";
  starContext.font = "11px monospace";
  starContext.textAlign = "center";
  starContext.fillText(displaySpectral, starContextX, starCanvasH - 6);

  const [starColor1, starColor2] = spectralToColor(
    stellarType ?? tempToSpectralClass(stellarTemp),
    stellarTemp,
  );
  const starRadius = Math.min(
    Math.max((stellarRadius ?? 1) * 20, 18),
    starContextX - 8,
  );

  const starGradient = starContext.createRadialGradient(
    starContextX - starRadius * 0.3,
    starContextY - starRadius * 0.3,
    starRadius * 0.05,
    starContextX,
    starContextY,
    starRadius,
  );
  starGradient.addColorStop(0, starColor1);
  starGradient.addColorStop(0.6, starColor2);
  starGradient.addColorStop(1, starColor2 + "44");

  starContext.beginPath();
  starContext.arc(starContextX, starContextY, starRadius, 0, Math.PI * 2);
  starContext.fillStyle = starGradient;
  starContext.fill();

  starContext.beginPath();
  starContext.arc(starContextX, starContextY, starRadius + 6, 0, Math.PI * 2);
  starContext.fillStyle = starColor2 + "18";
  starContext.fill();

  const compare = document.getElementById("size-compare");
  const bodies = [
    { name: "Earth", radius: 1, color: "#378ADD" },
    {
      name: planetName.split(" ")[0],
      radius: Math.max(planetRadius, 0.1),
      color: COLORS[planetType]?.[0] ?? "#888",
    },
    { name: "Neptune", radius: 3.88, color: "#4a8ed4" },
    { name: "Jupiter", radius: 11.2, color: "#E87C1E" },
  ];
  const maxR = Math.max(...bodies.map((body) => body.radius));
  const scale = 44 / maxR;
  bodies.forEach((body) => {
    const px = Math.max(body.radius * scale, 5);
    const div = document.createElement("div");
    div.style.cssText =
      "display:flex;flex-direction:column;align-items:center;gap:8px";
    div.innerHTML = `
      <div style="width:${px * 2}px;height:${px * 2}px;border-radius:50%;background:${body.color};opacity:.85;flex-shrink:0"></div>
      <div style="font-size:10px;color:var(--ds-gray-600);font-family:var(--font-geist-mono);white-space:nowrap">${body.name}</div>
    `;
    compare.appendChild(div);
  });

  const estimatedMass = planetMass ?? Math.pow(planetRadius, 2.06);
  const gravityRatio = Math.max(estimatedMass / planetRadius ** 2, 0.01);
  const slider = document.getElementById("weight-slider");
  const weightOut = document.getElementById("weight-out");
  const resWeight = document.getElementById("res-weight");
  const resGravity = document.getElementById("res-gravity");

  function updateGravity() {
    const w = Number(slider.value);
    weightOut.textContent = `${w} kg`;
    resWeight.textContent = `${(w * gravityRatio).toFixed(1)} kg`;
    resGravity.textContent = `${gravityRatio.toFixed(2)} g`;
  }

  slider.addEventListener("input", updateGravity);
  updateGravity();

  const bmBtn = document.getElementById("bookmark-btn");
  const bmIcon = document.getElementById("bookmark-icon");
  const bmLabel = document.getElementById("bookmark-label");

  function updateBookmarkUI(saved) {
    if (saved) {
      bmBtn.style.borderColor = "var(--ds-green-500)";
      bmBtn.style.color = "var(--ds-green-600)";
      bmIcon.setAttribute("fill", "currentColor");
      bmLabel.textContent = "Saved";
    } else {
      bmBtn.style.borderColor = "";
      bmBtn.style.color = "";
      bmIcon.setAttribute("fill", "none");
      bmLabel.textContent = "Save planet";
    }
  }

  function getBookmarks() {
    try {
      return JSON.parse(localStorage.getItem("exoatlas:bookmarks") ?? "[]");
    } catch {
      return [];
    }
  }

  const planetData = JSON.parse(bmBtn.dataset.planet);

  updateBookmarkUI(getBookmarks().some((b) => b.id === planetData.id));

  bmBtn.addEventListener("click", () => {
    const list = getBookmarks();
    const already = list.some((bm) => bm.id === planetData.id);
    if (already) {
      localStorage.setItem(
        "exoatlas:bookmarks",
        JSON.stringify(list.filter((bm) => bm.id !== planetData.id)),
      );
      updateBookmarkUI(false);
    } else {
      list.unshift({ ...planetData, savedAt: new Date().toISOString() });
      localStorage.setItem("exoatlas:bookmarks", JSON.stringify(list));
      updateBookmarkUI(true);
    }
  });

  async function loadAISummary() {
    try {
      const response = await fetch(`/api/ai/summary?id=${planetId}`);
      const json = await response.json();
      if (json.summary) {
        document.getElementById("ai-summary-loading").style.display = "none";
        const summaryElement = document.getElementById("ai-summary-text");
        summaryElement.style.display = "block";
        summaryElement.textContent = json.summary;
      }
    } catch {
      document.getElementById("ai-summary-loading").style.display = "none";
    }
  }

  async function loadAINarrative() {
    try {
      const response = await fetch(`/api/ai/narrative?id=${planetId}`);
      const json = await response.json();
      if (json.narrative) {
        document.getElementById("ai-narrative-loading").style.display = "none";
        const narrativeElement = document.getElementById("ai-narrative-text");
        narrativeElement.style.display = "block";
        narrativeElement.textContent = json.narrative;
      }
    } catch {
      document.getElementById("ai-narrative-loading").style.display = "none";
    }
  }
  loadAISummary();
  loadAINarrative();

  const container = document.getElementById("three-container");

  const script3 = document.createElement("script");
  script3.src =
    "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js";
  script3.onload = () => init3D();
  document.head.appendChild(script3);

  function init3D() {
    const containerW = container.clientWidth;
    const containerH = container.clientHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      45,
      containerW / containerH,
      0.1,
      2000,
    );
    camera.position.set(0, 120, 220);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(containerW, containerH);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000, 1);
    container.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.15);
    scene.add(ambientLight);

    const sunLight = new THREE.PointLight(0xffd060, 2.5, 800);
    sunLight.position.set(0, 0, 0);
    scene.add(sunLight);

    function getStarColor(temp) {
      if (!temp) return 0xffd060;
      if (temp > 30000) return 0x9bb0ff;
      if (temp > 10000) return 0xaabfff;
      if (temp > 7500) return 0xf8f7ff;
      if (temp > 6000) return 0xfff4e8;
      if (temp > 5200) return 0xffdd90;
      if (temp > 3700) return 0xffb347;
      return 0xff6b35;
    }

    const starColor = getStarColor(stellarTemp);

    const starR = Math.min(Math.max((stellarRadius ?? 1) * 8, 8), 28);
    const starGeo = new THREE.SphereGeometry(starR, 32, 32);
    const starMaterial = new THREE.MeshStandardMaterial({
      color: starColor,
      emissive: starColor,
      emissiveIntensity: 0.8,
      roughness: 1,
    });
    const starMesh = new THREE.Mesh(starGeo, starMaterial);
    scene.add(starMesh);

    const glowGeo = new THREE.SphereGeometry(starR * 1.6, 16, 16);
    const glowMaterial = new THREE.MeshBasicMaterial({
      color: starColor,
      transparent: true,
      opacity: 0.08,
    });
    scene.add(new THREE.Mesh(glowGeo, glowMaterial));

    const starCount = 1200;
    const starPositions = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      starPositions[i * 3] = (Math.random() - 0.5) * 1800;
      starPositions[i * 3 + 1] = (Math.random() - 0.5) * 1800;
      starPositions[i * 3 + 2] = (Math.random() - 0.5) * 1800;
    }
    const starBgGeo = new THREE.BufferGeometry();
    starBgGeo.setAttribute(
      "position",
      new THREE.BufferAttribute(starPositions, 3),
    );
    const starBgMaterial = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.8,
      transparent: true,
      opacity: 0.6,
    });
    scene.add(new THREE.Points(starBgGeo, starBgMaterial));

    const PlanetColors = {
      rocky: 0x8a7040,
      "super-earth": 0x3a9e75,
      "sub-neptune": 0x4a8ed4,
      "neptune-like": 0x3a7ed4,
      "ocean-world": 0x3a7ed4,
      "hot-jupiter": 0xe87c1e,
      "gas-giant": 0x8a5bc4,
      unknown: 0x505050,
    };

    const orbitRadius = Math.max(starR * 2.2 + 20, 70);
    const planetR = Math.min(Math.max(planetRadius * 3.5, 3), 16);
    const planetColor = PlanetColors[planetType] ?? 0x505050;
    const orbitPoints = [];
    for (let i = 0; i <= 128; i++) {
      const a = (i / 128) * Math.PI * 2;
      orbitPoints.push(
        new THREE.Vector3(
          Math.cos(a) * orbitRadius,
          0,
          Math.sin(a) * orbitRadius,
        ),
      );
    }

    const orbitGeo = new THREE.BufferGeometry().setFromPoints(orbitPoints);
    const orbitMaterial = new THREE.LineBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.12,
    });
    scene.add(new THREE.Line(orbitGeo, orbitMaterial));

    // const gridHelper = new THREE.GridHelper(
    //   orbitRadius * 2.4,
    //   12,
    //   0x223344,
    //   0x111a22,
    // );
    // scene.add(gridHelper);

    const planetGeo = new THREE.SphereGeometry(planetR, 32, 32);
    const planetMaterial = new THREE.MeshStandardMaterial({
      color: planetColor,
      roughness: 0.8,
      metalness: 0.1,
    });
    const planetMesh = new THREE.Mesh(planetGeo, planetMaterial);
    scene.add(planetMesh);

    if (
      (planetType === "super-earth" || planetType === "rocky") &&
      planetRadius < 2
    ) {
      const hazeGeo = new THREE.SphereGeometry(planetR * 1.15, 16, 16);
      const hazeMaterial = new THREE.MeshBasicMaterial({
        color: 0x4a8ed4,
        transparent: true,
        opacity: 0.08,
      });
      const hazeMesh = new THREE.Mesh(hazeGeo, hazeMaterial);
      planetMesh.add(hazeMesh);
    }

    if (planetType === "gas-giant" || planetType === "hot-jupiter") {
      const ringGeo = new THREE.RingGeometry(planetR * 1.4, planetR * 2.2, 64);
      const ringMaterial = new THREE.MeshBasicMaterial({
        color: planetColor,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.25,
      });

      const ringMesh = new THREE.Mesh(ringGeo, ringMaterial);
      ringMesh.rotation.x = Math.PI / 3;
      planetMesh.add(ringMesh);
    }

    const baseSpeed = 0.008;
    const speedRatio = 365.25 / (planetPeriod || 365.25);
    const orbSpeed = Math.min(
      Math.max(baseSpeed * Math.sqrt(speedRatio), 0.002),
      0.04,
    );

    let angle = 0;
    let paused = false;

    function animate() {
      animId = requestAnimationFrame(animate);
      if (!paused) {
        angle += orbSpeed;
        planetMesh.position.x = Math.cos(angle) * orbitRadius;
        planetMesh.position.z = Math.sin(angle) * orbitRadius;
        planetMesh.rotation.y += 0.005;
      }
      controls.update();
      renderer.render(scene, camera);
    }

    const controls = {
      isDragging: false,
      lastX: 0,
      lastY: 0,
      theta: 0.4,
      phi: 1.1,
      radius: 260,
      update() {
        camera.position.x =
          this.radius * Math.sin(this.phi) * Math.sin(this.theta);
        camera.position.y = this.radius * Math.cos(this.phi);
        camera.position.z =
          this.radius * Math.sin(this.phi) * Math.cos(this.theta);
        camera.lookAt(0, 0, 0);
      },
    };

    renderer.domElement.addEventListener("mousedown", (e) => {
      controls.isDragging = true;
      controls.lastX = e.clientX;
      controls.lastY = e.clientY;
    });
    renderer.domElement.addEventListener("mousemove", (e) => {
      if (!controls.isDragging) return;
      const dx = e.clientX - controls.lastX;
      const dy = e.clientY - controls.lastY;
      controls.theta -= dx * 0.008;
      controls.phi = Math.max(
        0.2,
        Math.min(Math.PI - 0.2, controls.phi + dy * 0.008),
      );
      controls.lastX = e.clientX;
      controls.lastY = e.clientY;
    });
    renderer.domElement.addEventListener("mouseup", () => {
      controls.isDragging = false;
    });
    renderer.domElement.addEventListener("mouseleave", () => {
      controls.isDragging = false;
    });
    renderer.domElement.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        controls.radius = Math.max(
          60,
          Math.min(500, controls.radius + e.deltaY * 0.3),
        );
      },
      { passive: false },
    );

    let lastTouchDist = 0;
    renderer.domElement.addEventListener("touchstart", (e) => {
      if (e.touches.length === 1) {
        controls.isDragging = true;
        controls.lastX = e.touches[0].clientX;
        controls.lastY = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        lastTouchDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );
      }
    });
    renderer.domElement.addEventListener(
      "touchmove",
      (e) => {
        e.preventDefault();
        if (e.touches.length === 1 && controls.isDragging) {
          const dx = e.touches[0].clientX - controls.lastX;
          const dy = e.touches[0].clientY - controls.lastY;
          controls.theta -= dx * 0.008;
          controls.phi = Math.max(
            0.2,
            Math.min(Math.PI - 0.2, controls.phi + dy * 0.008),
          );
          controls.lastX = e.touches[0].clientX;
          controls.lastY = e.touches[0].clientY;
        } else if (e.touches.length === 2) {
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY,
          );
          controls.radius = Math.max(
            60,
            Math.min(500, controls.radius - (dist - lastTouchDist) * 0.5),
          );
          lastTouchDist = dist;
        }
      },
      { passive: false },
    );
    renderer.domElement.addEventListener("touchend", () => {
      controls.isDragging = false;
    });

    renderer.domElement.addEventListener("click", () => {
      paused = !paused;
    });

    document.getElementById("reset-camera")?.addEventListener("click", () => {
      controls.theta = 0.4;
      controls.phi = 1.1;
      controls.radius = 260;
      paused = false;
    });

    window.addEventListener("resize", () => {
      const contW = container.clientWidth;
      const contH = container.clientHeight;
      camera.aspect = contW / contH;
      camera.updateProjectionMatrix();
      renderer.setSize(contW, contH);
    });
    const label = document.createElement("div");
    label.style.cssText =
      "position:absolute;bottom:12px;left:16px;font-family:var(--font-geist-mono);font-size:10px;color:rgba(255,255,255,0.4);pointer-events:none;line-height:1.6";
    label.innerHTML = `${planetName} orbiting ${hostStar}<br>1 orbit = ${
      planetPeriod < 1
        ? `${(planetPeriod * 24).toFixed(1)}h`
        : planetPeriod > 1000
          ? `${(planetPeriod / 365.25).toFixed(1)}yr`
          : `${planetPeriod.toFixed(1)}d`
    } · click to pause`;
    container.style.position = "relative";
    container.appendChild(label);
    controls.update();
    animate();
  }
  const STEFAN_BOLTZMANN = 5.67e-8;

  function calculateHZ(opts) {
    const { stellarTemp, stellarRadius, orbitalPeriod } = opts;

    const T = stellarTemp ?? 5778;
    const R = stellarRadius ?? 1.0;

    const L_sun = 3.828e26;
    const L =
      (4 *
        Math.PI *
        Math.pow(R * 6.957e8, 2) *
        STEFAN_BOLTZMANN *
        Math.pow(T, 4)) /
      L_sun;

    const S_inner_opt = 1.7763;
    const S_outer_opt = 0.3207;

    const S_inner_cons = 1.0385;
    const S_outer_cons = 0.3507;

    const innerAU = Math.sqrt(L / S_inner_opt);
    const outerAU = Math.sqrt(L / S_outer_opt);
    const conservativeInnerAU = Math.sqrt(L / S_inner_cons);
    const conservativeOuterAU = Math.sqrt(L / S_outer_cons);

    let planetAU = null;
    if (orbitalPeriod) {
      const M_star = Math.pow(L, 0.25);
      const P_yr = orbitalPeriod / 365.25;
      planetAU = Math.cbrt(M_star * P_yr * P_yr);
    }

    let classification = "unknown";
    let classLabel = "Unknown";
    let classColor = "var(--ds-gray-500)";

    if (planetAU !== null) {
      if (planetAU < innerAU * 0.85) {
        classification = "too-hot";
        classLabel = "Too hot";
        classColor = "var(--ds-red-500)";
      } else if (planetAU < conservativeInnerAU) {
        classification = "inner-edge";
        classLabel = "Inner edge";
        classColor = "var(--ds-amber-500)";
      } else if (planetAU <= conservativeOuterAU) {
        classification = "habitable";
        classLabel = "Habitable zone";
        classColor = "var(--ds-green-500)";
      } else if (planetAU <= outerAU * 1.15) {
        classification = "outer-edge";
        classLabel = "Outer edge";
        classColor = "var(--ds-blue-400)";
      } else {
        classification = "too-cold";
        classLabel = "Too cold";
        classColor = "var(--ds-blue-600)";
      }
    }

    return {
      luminosity: L,
      innerAU,
      outerAU,
      conservativeInnerAU,
      conservativeOuterAU,
      planetAU,
      classification,
      classLabel,
      classColor,
    };
  }

  function drawHZCanvas(canvas, hz, planetType, planetName) {
    canvas.width = canvas.offsetWidth || 600;
    const HZCanvasW = canvas.width;
    const HZCanvasH = canvas.height;
    const HZContext = canvas.getContext("2d");

    HZContext.clearRect(0, 0, HZCanvasW, HZCanvasH);
    HZContext.fillStyle = "#000";
    HZContext.fillRect(0, 0, HZCanvasW, HZCanvasH);

    const HZ_PAD_L = 60;
    const HZ_PAD_R = 30;
    const HZCenterY = HZCanvasH / 2;

    const maxAU = Math.max(hz.outerAU * 1.5, (hz.planetAU ?? 0) * 1.3, 2);
    const minAU = 0;

    function xOf(au) {
      return (
        HZ_PAD_L +
        ((au - minAU) / (maxAU - minAU)) * (HZCanvasW - HZ_PAD_L - HZ_PAD_R)
      );
    }

    const starColor = getStarColor(hz.luminosity);
    const starR = Math.min(Math.max(hz.luminosity * 3, 10), 28);

    const starGlow = HZContext.createRadialGradient(
      HZ_PAD_L - 10,
      HZCenterY,
      0,
      HZ_PAD_L - 10,
      HZCenterY,
      starR * 3,
    );
    starGlow.addColorStop(0, starColor + "aa");
    starGlow.addColorStop(0.5, starColor + "22");
    starGlow.addColorStop(1, "transparent");
    HZContext.fillStyle = starGlow;
    HZContext.fillRect(0, 0, HZ_PAD_L + starR * 3, HZCanvasH);

    HZContext.beginPath();
    HZContext.arc(HZ_PAD_L - 10, HZCenterY, starR, 0, Math.PI * 2);
    HZContext.fillStyle = starColor;
    HZContext.fill();

    const x_inner_opt = xOf(hz.innerAU);
    const x_outer_opt = xOf(hz.outerAU);

    const hzGradOpt = HZContext.createLinearGradient(
      x_inner_opt,
      0,
      x_outer_opt,
      0,
    );
    hzGradOpt.addColorStop(0, "rgba(34,197,94,0.05)");
    hzGradOpt.addColorStop(0.5, "rgba(34,197,94,0.08)");
    hzGradOpt.addColorStop(1, "rgba(34,197,94,0.03)");
    HZContext.fillStyle = hzGradOpt;
    HZContext.fillRect(
      x_inner_opt,
      HZCenterY - 38,
      x_outer_opt - x_inner_opt,
      76,
    );

    const x_inner_cons = xOf(hz.conservativeInnerAU);
    const x_outer_cons = xOf(hz.conservativeOuterAU);

    const hzGrad = HZContext.createLinearGradient(
      x_inner_cons,
      0,
      x_outer_cons,
      0,
    );
    hzGrad.addColorStop(0, "rgba(34,197,94,0.08)");
    hzGrad.addColorStop(0.3, "rgba(34,197,94,0.22)");
    hzGrad.addColorStop(0.7, "rgba(34,197,94,0.22)");
    hzGrad.addColorStop(1, "rgba(34,197,94,0.08)");
    HZContext.fillStyle = hzGrad;
    HZContext.fillRect(
      x_inner_cons,
      HZCenterY - 28,
      x_outer_cons - x_inner_cons,
      56,
    );

    HZContext.strokeStyle = "rgba(34,197,94,0.4)";
    HZContext.lineWidth = 1;
    HZContext.setLineDash([4, 4]);
    [x_inner_cons, x_outer_cons].forEach((x) => {
      HZContext.beginPath();
      HZContext.moveTo(x, HZCenterY - 40);
      HZContext.lineTo(x, HZCenterY + 40);
      HZContext.stroke();
    });
    HZContext.setLineDash([]);

    HZContext.strokeStyle = "rgba(255,255,255,0.06)";
    HZContext.lineWidth = 1;
    HZContext.beginPath();
    HZContext.moveTo(HZ_PAD_L - 10, HZCenterY);
    HZContext.lineTo(HZCanvasW - HZ_PAD_R, HZCenterY);
    HZContext.stroke();

    const tickAUs = getTickValues(maxAU);
    tickAUs.forEach((au) => {
      const x = xOf(au);
      HZContext.strokeStyle = "rgba(255,255,255,0.08)";
      HZContext.lineWidth = 0.5;
      HZContext.beginPath();
      HZContext.moveTo(x, HZCenterY + 30);
      HZContext.lineTo(x, HZCenterY + 38);
      HZContext.stroke();
      HZContext.fillStyle = "rgba(255,255,255,0.25)";
      HZContext.font = "12px monospace";
      HZContext.textAlign = "center";
      HZContext.fillText(`${au} AU`, x, HZCenterY + 50);
    });

    const earthX = xOf(1.0);
    if (earthX > HZ_PAD_L && earthX < HZCanvasW - HZ_PAD_R) {
      HZContext.beginPath();
      HZContext.arc(earthX, HZCenterY, 5, 0, Math.PI * 2);
      HZContext.fillStyle = "#378ADD88";
      HZContext.fill();
      HZContext.fillStyle = "rgba(55,138,221,0.5)";
      HZContext.font = "11px monospace";
      HZContext.textAlign = "center";
      HZContext.fillText("Earth", earthX, HZCenterY - 12);
    }

    if (hz.planetAU !== null) {
      const PLANET_COLORS = {
        rocky: "#8a7040",
        "super-earth": "#3a9e75",
        "sub-neptune": "#4a8ed4",
        "neptune-like": "#3a7ed4",
        "ocean-world": "#3a7ed4",
        "hot-jupiter": "#E87C1E",
        "gas-giant": "#8a5bc4",
        unknown: "#505050",
      };
      const pc = PLANET_COLORS[planetType] ?? "#505050";
      const px = xOf(hz.planetAU);
      const inHz = hz.classification === "habitable";

      const glow = HZContext.createRadialGradient(
        px,
        HZCenterY,
        0,
        px,
        HZCenterY,
        20,
      );
      glow.addColorStop(0, (inHz ? "#22c55e" : pc) + "44");
      glow.addColorStop(1, "transparent");
      HZContext.fillStyle = glow;
      HZContext.beginPath();
      HZContext.arc(px, HZCenterY, 20, 0, Math.PI * 2);
      HZContext.fill();

      HZContext.beginPath();
      HZContext.arc(px, HZCenterY, 7, 0, Math.PI * 2);
      HZContext.fillStyle = pc;
      HZContext.fill();

      HZContext.fillStyle = hz.classColor;
      HZContext.font = "bold 10px monospace";
      HZContext.textAlign = "center";
      HZContext.fillText(hz.classLabel, px, HZCenterY - 18);

      HZContext.fillStyle = "rgba(255,255,255,0.3)";
      HZContext.font = "9px monospace";
      HZContext.fillText(`${hz.planetAU.toFixed(3)} AU`, px, HZCenterY + 18);

      HZContext.fillStyle = "rgba(255,255,255,0.5)";
      HZContext.font = "10px monospace";
      HZContext.fillText(planetName.split(" ")[0], px, HZCenterY - 30);
    }

    const legend = [
      { color: "rgba(34,197,94,0.5)", label: "Conservative HZ" },
      { color: "rgba(34,197,94,0.15)", label: "Optimistic HZ" },
    ];
    legend.forEach((legend, i) => {
      const lx = HZCanvasW - 5 * HZ_PAD_R;
      const ly = 14 + i * 16;
      HZContext.fillStyle = legend.color;
      HZContext.fillRect(lx, ly, 20, 8);
      HZContext.fillStyle = "rgba(255,255,255,0.35)";
      HZContext.font = "12px monospace";
      HZContext.textAlign = "left";
      HZContext.fillText(legend.label, lx + 26, ly + 7);
    });

    if (x_inner_cons > HZ_PAD_L + 20) {
      HZContext.fillStyle = "rgba(34,197,94,0.5)";
      HZContext.font = "11px monospace";
      HZContext.textAlign = "center";
      HZContext.fillText("Inner", x_inner_cons, HZCenterY - 46);
    }
    HZContext.fillStyle = "rgba(34,197,94,0.5)";
    HZContext.font = "11px monospace";
    HZContext.textAlign = "center";
    HZContext.fillText("Outer", x_outer_cons, HZCenterY - 46);
  }

  function getStarColor(luminosity) {
    if (luminosity > 10000) return "#9bb0ff";
    if (luminosity > 100) return "#aabfff";
    if (luminosity > 5) return "#fff4e8";
    if (luminosity > 1.5) return "#ffdd90";
    if (luminosity > 0.5) return "#ffb347";
    return "#ff6b35";
  }

  function getTickValues(maxAU) {
    const step = maxAU < 2 ? 0.25 : maxAU < 5 ? 0.5 : 1;
    const ticks = [];
    for (let v = 0; v <= maxAU; v += step) {
      ticks.push(Math.round(v * 100) / 100);
    }
    return ticks;
  }

  function animateHZCanvas(canvas, hz, planetType, planetName) {
    let frame = 0;
    let animId;

    function tick() {
      drawHZCanvas(canvas, hz, planetType, planetName);

      if (hz.planetAU !== null) {
        const HZContext = canvas.getContext("2d");
        const HZCanvasW = canvas.width;
        const HZCanvasH = canvas.height;
        const HZ_PAD_L = 60;
        const HZ_PAD_R = 30;
        const HZCenterY = HZCanvasH / 2;
        const maxAU = Math.max(hz.outerAU * 1.5, hz.planetAU * 1.3, 2);

        function xOf(au) {
          return HZ_PAD_L + (au / maxAU) * (HZCanvasW - HZ_PAD_L - HZ_PAD_R);
        }

        const px = xOf(hz.planetAU);
        const pulse = Math.sin(frame * 0.05) * 0.5 + 0.5;
        const inHz = hz.classification === "habitable";
        const pulseCol = inHz
          ? `rgba(34,197,94,${pulse * 0.4})`
          : `rgba(255,255,255,${pulse * 0.15})`;

        HZContext.beginPath();
        HZContext.arc(px, HZCenterY, 7 + pulse * 6, 0, Math.PI * 2);
        HZContext.strokeStyle = pulseCol;
        HZContext.lineWidth = 1;
        HZContext.stroke();
      }

      frame++;
      animId = requestAnimationFrame(tick);
    }

    tick();
    return () => cancelAnimationFrame(animId);
  }

  const hz = calculateHZ({
    stellarTemp: stellarTemp,
    stellarRadius: stellarRadius,
    orbitalPeriod: planetPeriod,
  });

  const HZCanvas = document.getElementById("hz-canvas");
  if (HZCanvas) {
    HZCanvas.width = HZCanvas.offsetWidth || 600;
    animateHZCanvas(HZCanvas, hz, planetType, planetName);
  }

  const hzBadge = document.getElementById("hz-badge");
  if (hzBadge) {
    hzBadge.textContent = hz.classLabel;
    hzBadge.style.color = hz.classColor;
    hzBadge.style.borderColor = hz.classColor + "66";
    hzBadge.style.background = hz.classColor + "11";
  }

  const setEl = (id, val) => {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  };

  setEl("hz-luminosity", `${hz.luminosity.toFixed(3)} L☉`);
  setEl("hz-planet-au", hz.planetAU ? `${hz.planetAU.toFixed(4)} AU` : "—");
  setEl("hz-inner", `${hz.conservativeInnerAU.toFixed(3)} AU`);
  setEl("hz-outer", `${hz.conservativeOuterAU.toFixed(3)} AU`);

  function estimateAtmosphere(opts) {
    const { radius, mass, temp, planetType } = opts;

    const r = radius ?? 1;
    const m = mass ?? Math.pow(r, 2.06);
    const t = temp ?? 255;
    const g = m / (r * r);

    const retentionScore = g * (300 / Math.max(t, 100));

    if (planetType === "gas-giant" || r > 6) {
      return gasGiant();
    }

    if (planetType === "hot-jupiter" || (r > 4 && t > 800)) {
      return hotJupiter(t);
    }

    if (
      planetType === "sub-neptune" ||
      planetType === "neptune-like" ||
      (r > 2.5 && r < 6)
    ) {
      return hydrogenEnvelope();
    }

    if (
      planetType === "ocean-world" ||
      (r > 1.2 && r < 2.5 && t > 200 && t < 400)
    ) {
      return waterWorld(t);
    }

    if (retentionScore < 0.3 || t > 700) {
      return noAtmosphere();
    }

    if (retentionScore < 0.6) {
      return thinRocky(t);
    }

    if (t > 340 && t < 700) {
      return co2Dominated(t);
    }

    if (t >= 200 && t <= 340 && retentionScore > 0.7) {
      return earthLike(g);
    }

    if (t < 200) {
      return co2Dominated(t);
    }

    return thinRocky(t);
  }

  function noAtmosphere() {
    return {
      class: "none",
      label: "No atmosphere",
      description:
        "Too small or too hot to retain significant gas. Surface exposed directly to stellar radiation.",
      pressure: "< 0.001 atm",
      breathable: false,
      color: "#888",
      hazeColor: "transparent",
      hazeOpacity: 0,
      hazeThickness: 0,
      composition: [
        { molecule: "Trace Na", pct: 60, color: "#aaa" },
        { molecule: "Trace K", pct: 40, color: "#999" },
      ],
    };
  }

  function thinRocky(temp) {
    return {
      class: "thin-rocky",
      label: "Thin rocky atmosphere",
      description:
        "Tenuous atmosphere, likely volcanic outgassing. Similar to Mars — not breathable but provides some protection.",
      pressure: "0.001–0.1 atm",
      breathable: false,
      color: "#c8a878",
      hazeColor: "#c8a87844",
      hazeOpacity: 0.12,
      hazeThickness: 0.05,
      composition:
        temp > 300
          ? [
              { molecule: "CO₂", pct: 95, color: "#e87c1e" },
              { molecule: "N₂", pct: 3, color: "#4a8ed4" },
              { molecule: "SO₂", pct: 2, color: "#ffdd90" },
            ]
          : [
              { molecule: "CO₂", pct: 80, color: "#e87c1e" },
              { molecule: "N₂", pct: 15, color: "#4a8ed4" },
              { molecule: "Ar", pct: 5, color: "#8a8a8a" },
            ],
    };
  }

  function earthLike(g) {
    const o2 = Math.min(25, Math.max(15, 21 * g));
    return {
      class: "earth-like",
      label: "Earth-like atmosphere",
      description:
        "Nitrogen-oxygen atmosphere within habitable conditions. Surface liquid water possible. Potentially breathable.",
      pressure: `${(0.8 + g * 0.4).toFixed(1)}–${(1.0 + g * 0.6).toFixed(1)} atm`,
      breathable: true,
      color: "#4a8ed4",
      hazeColor: "#4a8ed466",
      hazeOpacity: 0.2,
      hazeThickness: 0.12,
      composition: [
        { molecule: "N₂", pct: Math.round(78 - (o2 - 21)), color: "#4a8ed4" },
        { molecule: "O₂", pct: Math.round(o2), color: "#3a9e75" },
        { molecule: "Ar", pct: 1, color: "#8a8a8a" },
        { molecule: "CO₂", pct: 0.04, color: "#e87c1e" },
        { molecule: "H₂O", pct: 1, color: "#85B7EB" },
      ],
    };
  }

  function co2Dominated(temp) {
    const hot = temp > 340;
    return {
      class: "co2-dominated",
      label: hot ? "Runaway greenhouse" : "CO₂ atmosphere",
      description: hot
        ? "Dense CO₂ envelope trapping heat in a runaway greenhouse effect. Surface temperatures extreme — similar to Venus."
        : "Carbon dioxide dominated atmosphere. Thick enough to provide some warming but not breathable without equipment.",
      pressure: hot ? "50–100 atm" : "1–10 atm",
      breathable: false,
      color: "#e87c1e",
      hazeColor: "#e87c1e55",
      hazeOpacity: hot ? 0.3 : 0.18,
      hazeThickness: hot ? 0.18 : 0.1,
      composition: [
        { molecule: "CO₂", pct: 96, color: "#e87c1e" },
        { molecule: "N₂", pct: 3.5, color: "#4a8ed4" },
        { molecule: "SO₂", pct: 0.5, color: "#ffdd90" },
      ],
    };
  }

  function waterWorld(temp) {
    const steam = temp > 320;
    return {
      class: "water-steam",
      label: steam ? "Steam atmosphere" : "Water-rich atmosphere",
      description: steam
        ? "High temperatures have vaporised surface water into a dense steam atmosphere. Extreme humidity and pressure."
        : "Water-rich atmosphere with significant vapour. Global ocean likely beneath thick cloud cover.",
      pressure: steam ? "10–100 atm" : "1–5 atm",
      breathable: false,
      color: "#85B7EB",
      hazeColor: "#85B7EB55",
      hazeOpacity: 0.25,
      hazeThickness: 0.15,
      composition: [
        { molecule: "H₂O", pct: steam ? 80 : 40, color: "#85B7EB" },
        { molecule: "CO₂", pct: steam ? 15 : 30, color: "#e87c1e" },
        { molecule: "N₂", pct: steam ? 5 : 30, color: "#4a8ed4" },
      ],
    };
  }

  function hydrogenEnvelope() {
    return {
      class: "hydrogen-envelope",
      label: "Hydrogen envelope",
      description:
        "Thick hydrogen and helium envelope — a mini-Neptune. No solid surface to stand on. Increasing pressure with depth.",
      pressure: "> 1000 atm",
      breathable: false,
      color: "#8a5bc4",
      hazeColor: "#8a5bc455",
      hazeOpacity: 0.22,
      hazeThickness: 0.2,
      composition: [
        { molecule: "H₂", pct: 80, color: "#AFA9EC" },
        { molecule: "He", pct: 17, color: "#c084fc" },
        { molecule: "CH₄", pct: 2, color: "#85B7EB" },
        { molecule: "NH₃", pct: 1, color: "#ffdd90" },
      ],
    };
  }

  function gasGiant() {
    return {
      class: "thick-gas",
      label: "Gas giant atmosphere",
      description:
        "Massive hydrogen-helium atmosphere with no solid surface. Bands of clouds at different pressure levels.",
      pressure: "> 100,000 atm",
      breathable: false,
      color: "#E87C1E",
      hazeColor: "#E87C1E44",
      hazeOpacity: 0.28,
      hazeThickness: 0.25,
      composition: [
        { molecule: "H₂", pct: 89, color: "#AFA9EC" },
        { molecule: "He", pct: 10, color: "#c084fc" },
        { molecule: "CH₄", pct: 0.3, color: "#85B7EB" },
        { molecule: "NH₃", pct: 0.3, color: "#ffdd90" },
      ],
    };
  }

  function hotJupiter(temp) {
    return {
      class: "thick-gas",
      label: "Inflated hot Jupiter",
      description: `Superheated atmosphere at ~${Math.round(temp)} K. Tidally locked — permanent day/night sides with extreme wind speeds.`,
      pressure: "> 100,000 atm",
      breathable: false,
      color: "#E87C1E",
      hazeColor: "#E87C1E55",
      hazeOpacity: 0.32,
      hazeThickness: 0.28,
      composition: [
        { molecule: "H₂", pct: 85, color: "#AFA9EC" },
        { molecule: "He", pct: 13, color: "#c084fc" },
        { molecule: "Na", pct: 1, color: "#ffdd90" },
        { molecule: "K", pct: 1, color: "#FAC775" },
      ],
    };
  }

  function drawAtmosphereRing(canvas, atm, planetType, radius) {
    const atmContext = canvas.getContext("2d");
    const size = canvas.width;
    const centerX = size / 2;
    const centerY = size / 2;
    const pr = Math.min(Math.max(radius * (size / 8), size * 0.1), size * 0.44);

    if (atm.hazeThickness === 0 || atm.hazeOpacity === 0) return;

    const hazeR = pr * (1 + atm.hazeThickness);

    const glow = atmContext.createRadialGradient(
      centerX,
      centerY,
      pr,
      centerX,
      centerY,
      hazeR * 1.3,
    );
    glow.addColorStop(0, atm.hazeColor);
    glow.addColorStop(
      0.6,
      atm.hazeColor.replace("55", "22").replace("44", "18").replace("66", "28"),
    );
    glow.addColorStop(1, "transparent");
    atmContext.beginPath();
    atmContext.arc(centerX, centerY, hazeR * 1.3, 0, Math.PI * 2);
    atmContext.fillStyle = glow;
    atmContext.fill();

    atmContext.beginPath();
    atmContext.arc(centerX, centerY, hazeR, 0, Math.PI * 2);
    atmContext.strokeStyle = atm.hazeColor;
    atmContext.lineWidth = pr * atm.hazeThickness * 0.6;
    atmContext.globalAlpha = atm.hazeOpacity;
    atmContext.stroke();
    atmContext.globalAlpha = 1;
  }

  const atm = estimateAtmosphere({
    radius: planetRadius,
    mass: planetMass,
    temp: planetTemp,
    planetType: planetType,
  });

  const planetCvs = document.getElementById("planet-canvas");
  if (planetCvs) {
    drawAtmosphereRing(planetCvs, atm, planetType, planetRadius);
  }

  const atmBadge = document.getElementById("atm-badge");
  if (atmBadge) {
    atmBadge.textContent = atm.label;
    atmBadge.style.color = atm.color;
    atmBadge.style.borderColor = atm.color + "66";
    atmBadge.style.background = atm.color + "11";
  }

  const atmBreathable = document.getElementById("atm-breathable");
  if (atmBreathable) {
    atmBreathable.style.display = "inline-block";
    atmBreathable.textContent = atm.breathable
      ? "✓ Potentially breathable"
      : "✗ Not breathable";
    atmBreathable.style.background = atm.breathable
      ? "var(--ds-teal-200)"
      : "var(--ds-red-200)";
    atmBreathable.style.color = atm.breathable
      ? "var(--ds-teal-800)"
      : "var(--ds-red-800)";
  }

  const setElement = (id, value) => {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  };

  setElement("atm-description", atm.description);
  setElement("atm-pressure", atm.pressure);
  setElement("atm-breathable-stat", atm.breathable ? "Possibly yes" : "No");

  const compoElement = document.getElementById("atm-composition");
  if (compoElement) {
    compoElement.innerHTML = atm.composition
      .map(
        (compo) => `
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px">
          <span style="font-family:var(--font-geist-mono);font-size:11px;color:var(--ds-gray-700)">${compo.molecule}</span>
          <span style="font-family:var(--font-geist-mono);font-size:11px;color:var(--ds-gray-600)">${compo.pct < 1 ? compo.pct.toFixed(2) : compo.pct}%</span>
        </div>
        <div style="height:4px;background:var(--ds-gray-300);border-radius:2px;overflow:hidden">
          <div style="width:${Math.min(compo.pct, 100)}%;height:100%;border-radius:2px;background:${compo.color};transition:width .6s ease"></div>
        </div>
      </div>
    `,
      )
      .join("");
  }

  const compareBtn = document.getElementById("compare-btn");
  const compareModal = document.getElementById("compare-modal");
  const closeModal = document.getElementById("close-compare-modal");
  const compareInput = document.getElementById("compare-search-input");
  const compareRes = document.getElementById("compare-results");

  compareBtn?.addEventListener("click", () => {
    compareModal.style.display = "flex";
    compareInput.focus();
  });

  closeModal?.addEventListener("click", () => {
    compareModal.style.display = "none";
  });

  compareModal?.addEventListener("click", (e) => {
    if (e.target === compareModal) compareModal.style.display = "none";
  });

  let searchTimer;
  compareInput?.addEventListener("input", () => {
    clearTimeout(searchTimer);
    const q = compareInput.value.trim();
    if (!q) {
      compareRes.innerHTML = "";
      return;
    }

    searchTimer = setTimeout(async () => {
      const res = await fetch(
        `/api/planets?q=${encodeURIComponent(q)}&limit=8`,
      );
      const json = await res.json();

      compareRes.innerHTML = "";
      json.data?.forEach((p) => {
        const row = document.createElement("button");
        row.style.cssText =
          "display:flex;align-items:center;justify-content:space-between;width:100%;padding:10px 12px;border-radius:8px;border:0.5px solid var(--ds-gray-300);background:var(--ds-background-200);cursor:pointer;text-align:left;transition:border-color .15s";
        row.onmouseenter = () => (row.style.borderColor = "var(--ds-gray-500)");
        row.onmouseleave = () => (row.style.borderColor = "var(--ds-gray-300)");
        row.innerHTML = `
          <div>
            <div style="font-size:13px;font-weight:500;color:var(--primary)">${p.name}</div>
            <div style="font-family:var(--font-geist-mono);font-size:11px;color:var(--ds-gray-600);margin-top:2px">${p.host_star} · ${p.planet_type ?? "unknown"}</div>
          </div>
          <div style="font-family:var(--font-geist-mono);font-size:11px;color:var(--ds-green-600)">${p.habitability_pct ?? 0}%</div>
        `;
        row.addEventListener("click", () => {
          const targetSlug = p.name.toLowerCase().replace(/\s+/g, "-");
          window.location.href = `/compare?a=${planetSlug}&b=${targetSlug}`;
        });
        compareRes.appendChild(row);
      });

      if (!json.data?.length) {
        compareRes.innerHTML =
          '<div style="text-align:center;color:var(--ds-gray-600);font-size:13px;padding:16px">No planets found</div>';
      }
    }, 250);
  });
</script>
