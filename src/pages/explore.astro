---
import Layout from "@/layouts/base.astro";
import { supabase } from "@/lib/supabase";
import Icon from "@/components/icons.astro";

export const prerender = true;

const { data: randomPlanet } = await supabase.rpc("get_random_planet");
const planet = randomPlanet?.[0] ?? null;

if (!planet) return Astro.redirect("/atlas");

const slug = planet.name.toLowerCase().replace(/\s+/g, "-");
const fmt = (v: number | null, d = 2) =>
  v != null ? Number(v).toFixed(d) : "—";

const period =
  planet.orbital_period == null
    ? "—"
    : planet.orbital_period < 1
      ? `${(planet.orbital_period * 24).toFixed(1)}h`
      : planet.orbital_period > 1000
        ? `${(planet.orbital_period / 365.25).toFixed(1)} yr`
        : `${planet.orbital_period.toFixed(1)} days`;

const typeStyles: Record<string, string> = {
  rocky: "bg-amber-100 text-amber-500",
  "super-earth": "bg-teal-200 text-teal-800",
  "sub-neptune": "bg-blue-200 text-blue-800",
  "neptune-like": "bg-blue-200 text-blue-800",
  "ocean-world": "bg-blue-200 text-blue-800",
  "hot-jupiter": "bg-amber-200 text-amber-800",
  "gas-giant": "bg-purple-200 text-purple-800",
  unknown: "bg-gray-200 text-gray-700",
};

const habColor =
  (planet.habitability_pct ?? 0) >= 70
    ? "var(--ds-green-600)"
    : (planet.habitability_pct ?? 0) >= 40
      ? "var(--ds-amber-600)"
      : "var(--ds-red-600)";

const planetType = planet.planet_type ?? "unknown";
---

<Layout title={`Explore — Exoplanet Atlas`}>
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <p
          class="font-mono text-xs text-gray-500 uppercase tracking-widest mb-1"
        >
          Random world
        </p>
        <h1 class="text-2xl font-medium text-primary">You landed on...</h1>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="next-btn"
          class="bg-primary group text-background-100 text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-secondary transition-colors flex items-center gap-2"
        >
          Next planet
          <Icon
            glyph="refresh-clockwise"
            class="group-hover:rotate-180 transition-all duration-300"
          />
        </button>
      </div>
    </div>

    <div
      class="bg-background-200 border border-gray-300 rounded-xl overflow-hidden mb-6 opacity-0 translate-y-3 transition-all duration-300"
      id="planet-reveal"
    >
      <div
        class="flex items-center justify-center bg-background-100 border-b border-gray-300 py-12"
      >
        <canvas
          id="planet-canvas"
          width="160"
          height="160"
          data-type={planetType}
          data-radius={planet.radius_earth ?? 1}></canvas>
      </div>

      <div class="p-6">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-xl font-medium text-primary">{planet.name}</h2>
          <span
            class={`${typeStyles[planetType ?? "unknown"]} text-xs font-medium rounded-full py-1 px-2.5`}
          >
            {planetType}
          </span>
        </div>
        <p class="font-mono text-sm text-gray-600 mb-6">
          {planet.host_star}
          {
            planet.distance_ly && (
              <span> · {Number(planet.distance_ly).toFixed(1)} ly</span>
            )
          }
        </p>

        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs text-gray-600">Habitability</span>
          <div class="flex-1 h-1.5 bg-gray-300 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full"
              style={`width:${planet.habitability_pct ?? 0}%;background:${habColor}`}
            >
            </div>
          </div>
          <span class="font-mono text-sm text-gray-900"
            >{planet.habitability_pct ?? 0}%</span
          >
        </div>

        <dl class="grid grid-cols-2 gap-3 mb-6">
          {
            [
              { label: "Radius", value: `${fmt(planet.radius_earth)} R⊕` },
              { label: "Mass", value: `${fmt(planet.mass_earth)} M⊕` },
              { label: "Period", value: period },
              { label: "Temp", value: `${fmt(planet.eq_temperature, 0)} K` },
              { label: "ESI", value: fmt(planet.esi_score, 3) },
              {
                label: "Found",
                value: planet.discovery_year?.toString() ?? "—",
              },
            ].map((measure) => (
              <div class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2.5">
                <dt class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]">
                  {measure.label}
                </dt>
                <dd class="font-mono text-sm text-primary">{measure.value}</dd>
              </div>
            ))
          }
        </dl>

        <div
          id="ai-text"
          class="text-sm text-gray-600 leading-relaxed mb-6 min-h-12"
        >
          <span class="font-mono text-xs text-gray-500"
            >Generating AI summary...</span
          >
        </div>

        <div class="flex gap-3">
          <a
            href={`/planet/${slug}`}
            class="group flex-1 flex gap-1 items-center justify-center text-center bg-primary text-background-100 text-sm font-medium py-2.5 rounded-lg hover:bg-gray-900 transition-all duration-300"
          >
            Full passport <Icon
              glyph="arrow-right"
              class="h-3.5 w-auto group-hover:translate-x-2 group-hover:scale-110 transition-all duration-300"
            />
          </a>
          <button
            id="bookmark-btn"
            data-planet={JSON.stringify({
              id: planet.id,
              name: planet.name,
              host_star: planet.host_star,
              planet_type: planet.planet_type,
              habitability_pct: planet.habitability_pct,
              radius_earth: planet.radius_earth,
              discovery_year: planet.discovery_year,
            })}
            class="border border-gray-300 text-gray-700 text-sm px-4 py-2.5 rounded-lg hover:border-gray-500 transition-colors flex items-center gap-2 cursor-pointer"
          >
            <Icon id="bm-icon" glyph="bookmark" />
            <span id="bm-label">Save</span>
          </button>
        </div>
      </div>
    </div>

    <div class="text-center">
      <p class="text-xs text-gray-500 font-mono mb-3">
        press <kbd
          class="border border-gray-400 rounded px-1.5 py-0.5 text-gray-600"
          >R</kbd
        > for another random planet
      </p>
    </div>
  </section>
</Layout>

<script
  is:inline
  define:vars={{
    planetId: planet.id,
    planetType,
    planetRadius: planet.radius_earth ?? 1,
    planetData: JSON.stringify({
      id: planet.id,
      name: planet.name,
      host_star: planet.host_star,
      planet_type: planet.planet_type,
      habitability_pct: planet.habitability_pct,
      radius_earth: planet.radius_earth,
      discovery_year: planet.discovery_year,
    }),
  }}
>
  const reveal = document.getElementById("planet-reveal");
  requestAnimationFrame(() => {
    reveal.style.opacity = "1";
    reveal.style.transform = "translateY(0)";
  });

  const COLORS = {
    rocky: ["#8a7040", "#6a5030"],
    "super-earth": ["#3a9e75", "#1a7e55"],
    "sub-neptune": ["#4a8ed4", "#2a6eb4"],
    "neptune-like": ["#3a7ed4", "#1a5eb4"],
    "ocean-world": ["#3a7ed4", "#1a5eb4"],
    "hot-jupiter": ["#E87C1E", "#c85c0e"],
    "gas-giant": ["#8a5bc4", "#6a3ba4"],
    unknown: ["#505050", "#303030"],
  };

  const planetCanvas = document.getElementById("planet-canvas");
  const planetContext = planetCanvas.getContext("2d");
  const [color1, color2] = COLORS[planetType ?? "unknown"];
  const size = 160,
    centerX = size / 2,
    centerY = size / 2;
  const radius = Math.min(Math.max(planetRadius * 22, 12), size * 0.44);
  const gradient = planetContext.createRadialGradient(
    centerX - radius * 0.3,
    centerY - radius * 0.3,
    radius * 0.1,
    centerX,
    centerY,
    radius,
  );
  gradient.addColorStop(0, color1);
  gradient.addColorStop(1, color2);
  planetContext.beginPath();
  planetContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
  planetContext.fillStyle = gradient;
  planetContext.fill();
  planetContext.beginPath();
  planetContext.arc(
    centerX - radius * 0.25,
    centerY - radius * 0.25,
    radius * 0.35,
    0,
    Math.PI * 2,
  );
  planetContext.fillStyle = "rgba(255,255,255,0.08)";
  planetContext.fill();

  fetch(`/api/ai/summary?id=${planetId}`)
    .then((response) => response.json())
    .then((json) => {
      const aiElement = document.getElementById("ai-text");
      if (aiElement && json.summary) aiElement.textContent = json.summary;
    })
    .catch(() => {
      const aiElement = document.getElementById("ai-text");
      if (aiElement) aiElement.style.display = "none";
    });

  document.getElementById("next-btn")?.addEventListener("click", () => {
    window.location.href = "/explore";
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "r" || e.key === "R") {
      if (document.activeElement?.tagName === "INPUT") return;
      window.location.href = "/explore";
    }
  });

  const bmBtn = document.getElementById("bookmark-btn");
  const bmIcon = document.getElementById("bm-icon");
  const bmLabel = document.getElementById("bm-label");
  const dataPlanet = JSON.parse(planetData);

  function getBookmarks() {
    try {
      return JSON.parse(localStorage.getItem("exoatlas:bookmarks") ?? "[]");
    } catch {
      return [];
    }
  }

  function updateBmUI(saved) {
    if (saved) {
      bmBtn.style.borderColor = "var(--ds-green-500)";
      bmBtn.style.color = "var(--ds-green-600)";
      bmIcon.setAttribute("fill", "currentColor");
      bmLabel.textContent = "Saved";
    } else {
      bmBtn.style.borderColor = "";
      bmBtn.style.color = "";
      bmIcon.setAttribute("fill", "none");
      bmLabel.textContent = "Save";
    }
  }

  updateBmUI(getBookmarks().some((bm) => bm.id === dataPlanet.id));

  bmBtn?.addEventListener("click", () => {
    const bmList = getBookmarks();
    const alreadyBm = bmList.some((bm) => bm.id === dataPlanet.id);
    if (alreadyBm) {
      localStorage.setItem(
        "exoatlas:bookmarks",
        JSON.stringify(bmList.filter((bm) => bm.id !== dataPlanet.id)),
      );
      updateBmUI(false);
    } else {
      bmList.unshift({ ...dataPlanet, savedAt: new Date().toISOString() });
      localStorage.setItem("exoatlas:bookmarks", JSON.stringify(bmList));
      updateBmUI(true);
    }
  });
</script>
