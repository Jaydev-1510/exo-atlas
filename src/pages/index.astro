---
import Layout from "@/layouts/base.astro";
import PlanetCard from "@/components/planetCard.astro";
import Icon from "@/components/icons.astro";
import { supabase, supabaseAdmin } from "@/lib/supabase";

export const prerender = true;

const [
  { data: featured },
  { count: total, data: stats },
  { count: habitableCount },
  { data: epodRows },
] = await Promise.all([
  supabase.rpc("get_planets", {
    p_sort: "esi_score",
    p_order: "desc",
    p_limit: 3,
    p_offset: 0,
    p_search: undefined,
    p_type: undefined,
    p_method: undefined,
    p_habitable: undefined,
    p_year_from: undefined,
    p_year_to: undefined,
    p_radius_min: undefined,
    p_radius_max: undefined,
  }),
  supabaseAdmin.from("planets").select("id, habitability_pct, discovery_year", {
    count: "exact",
    head: false,
  }),
  supabaseAdmin
    .from("planets")
    .select("", {
      count: "exact",
      head: false,
    })
    .gte("habitability_pct", 60),
  supabase.rpc("get_planet_of_the_day"),
]);

const habitable = habitableCount;
const epod = epodRows?.[0] ?? null;
const epodSlug = epod?.name.toLowerCase().replace(/\s+/g, "-") ?? "";
const latestYear = Math.max(
  ...(stats?.map((p) => p.discovery_year ?? 0) ?? [0]),
);

const fmt = (v: number | null, d = 2) =>
  v != null ? Number(v).toFixed(d) : "—";

const typeStyles: Record<string, string> = {
  rocky: "bg-amber-100 text-amber-500",
  "super-earth": "bg-teal-200 text-teal-800",
  "sub-neptune": "bg-blue-200 text-blue-800",
  "neptune-like": "bg-blue-200 text-blue-800",
  "ocean-world": "bg-blue-200 text-blue-800",
  "hot-jupiter": "bg-amber-200 text-amber-800",
  "gas-giant": "bg-purple-200 text-purple-800",
  unknown: "bg-gray-200 text-gray-700",
};

const habColor =
  (epod?.habitability_pct ?? 0) >= 70
    ? "var(--ds-green-600)"
    : (epod?.habitability_pct ?? 0) >= 40
      ? "var(--ds-amber-600)"
      : "var(--ds-red-600)";

const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout>
  <section class="py-20 text-center min-h-dvh">
    <p class="font-mono text-xs text-secondary tracking-widest uppercase mb-4">
      NASA Exoplanet Archive · Live data
    </p>
    <h1 class="text-white leading-tight mb-4 font-pixel-line text-heading-72">
      A passport for every world<br />beyond our solar system.
    </h1>
    <p
      class="text-secondary md:text-[20px] text-[14px] max-w-lg mx-auto mb-8 leading-relaxed"
    >
      Browse {total?.toLocaleString()}+ confirmed exoplanets. Explore orbits,
      atmospheres, and the chances of harbouring life.
    </p>
    <div class="flex gap-3 justify-center flex-wrap">
      <a
        href="/atlas"
        class="bg-primary text-background-100 text-sm
        font-medium px-5 py-2.5 rounded-lg hover:bg-secondary transition-colors"
      >
        Explore the atlas
      </a>

      <a
        href="/atlas?habitable=true"
        class="border border-gray-400 text-secondary
      text-sm px-5 py-2.5 rounded-lg hover:border-text-secondary hover:bg-background-200 transition-colors duration-300"
      >
        Habitable zone only
      </a>
    </div>
    <div
      class="grid grid-cols-3 border border-gray-300 rounded-xl overflow-hidden mt-20"
    >
      {
        [
          { num: total?.toLocaleString(), label: "Confirmed worlds" },
          { num: habitable?.toLocaleString(), label: "Habitable zone" },
          { num: latestYear.toString(), label: "Latest discovery" },
        ].map((content, i) => (
          <div
            class={`px-6 py-5 text-center "bg-background-100 hover:bg-background-200 transition-all duration-300 ${i < 2 ? "border-r border-gray-300" : ""}`}
          >
            <div class="font-mono text-2xl text-primary mb-1">
              {content.num}
            </div>
            <div class="text-xs text-secondary uppercase tracking-widest">
              {content.label}
            </div>
          </div>
        ))
      }
    </div>
  </section>
  {
    epod && (
      <section class="mb-20">
        <div class="flex items-center justify-between mb-5">
          <div>
            <p class="text-xs text-gray-500 mt-1 font-mono">{today}</p>
            <h2 class="text-heading-64 font-pixel-lie text-primary tracking-widest">
              Planet of the day.
            </h2>
          </div>
          <a
            href={`/planet/${epodSlug}`}
            class="group text-sm text-secondary hover:text-primary transition-colors flex items-center gap-1 duration-200"
          >
            Full passport{" "}
            <Icon
              glyph="arrow-right"
              class="h-full w-auto group-hover:translate-x-2 group-hover:scale-110 transition-all duration-300"
            />
          </a>
        </div>

        <a
          href={`/planet/${epodSlug}`}
          class="block bg-background-200 border border-gray-300 rounded-xl overflow-hidden hover:border-gray-500 transition-colors"
        >
          <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="flex items-center justify-center p-10 border-b md:border-b-0 md:border-r border-gray-300 bg-background-100 min-h-65">
              <canvas
                id="epod-canvas"
                width="180"
                height="180"
                data-type={epod.planet_type ?? "unknown"}
                data-radius={epod.radius_earth ?? 1}
              />
            </div>

            <div class="p-8 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="font-medium text-primary text-heading-48">
                  {epod.name}
                </h3>
                <span
                  class={`${typeStyles[epod.planet_type ?? "unknown"]} text-xs font-medium rounded-full py-1 px-2.5`}
                  style="font-size:.65rem;font-weight:500;padding:.2rem .6rem;"
                >
                  {epod.planet_type ?? "unknown"}
                </span>
              </div>
              <p class="font-mono text-sm text-gray-600 mb-6">
                {epod.host_star}
              </p>

              <div class="flex items-center gap-3 mb-6">
                <span class="text-xs text-gray-600">Habitability</span>
                <div class="flex-1 h-1.5 bg-gray-300 rounded-full overflow-hidden">
                  <div
                    class="h-full rounded-full"
                    style={`width:${epod.habitability_pct ?? 0}%;background:${habColor}`}
                  />
                </div>
                <span class="font-mono text-sm text-gray-900">
                  {epod.habitability_pct ?? 0}%
                </span>
              </div>

              <dl class="grid grid-cols-2 gap-3">
                {[
                  { label: "Radius", value: `${fmt(epod.radius_earth)} R⊕` },
                  { label: "Mass", value: `${fmt(epod.mass_earth)} M⊕` },
                  {
                    label: "Period",
                    value: epod.orbital_period
                      ? `${Number(epod.orbital_period).toFixed(1)}d`
                      : "—",
                  },
                  {
                    label: "Temp",
                    value: `${fmt(epod.eq_temperature, 0)} K`,
                  },
                  { label: "ESI", value: fmt(epod.esi_score, 3) },
                  {
                    label: "Distance",
                    value: epod.distance_ly
                      ? `${Number(epod.distance_ly).toFixed(1)} ly`
                      : "—",
                  },
                ].map((measure) => (
                  <div class="bg-background-100 border border-gray-200 rounded-lg px-3 py-2">
                    <dt class="text-[10px] text-gray-500 mb-1 uppercase tracking-[0.07em]">
                      {measure.label}
                    </dt>
                    <dd class="font-mono text-sm text-gray-1000">
                      {measure.value}
                    </dd>
                  </div>
                ))}
              </dl>

              <div
                id="epod-ai"
                class="mt-5 text-sm text-gray-600 leading-relaxed italic min-h[1.5rem]"
              >
                <span id="epod-ai-text" class="text-gray-500 font-mono text-xs">
                  Loading AI summary...
                </span>
              </div>
            </div>
          </div>
        </a>
      </section>
    )
  }
  <section class="mb-20">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-heading-64 font-pixel-lie text-primary tracking-widest">
        Top rated worlds.
      </h2>
      <a
        href="/atlas"
        class="group text-sm text-secondary hover:text-primary transition-colors flex items-center gap-1 duration-200"
        >View all <Icon
          glyph="arrow-right"
          class="h-full w-auto group-hover:translate-x-2 group-hover:scale-110 transition-all duration-300"
        />
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured?.map((planet) => <PlanetCard {...planet} />)}
    </div>
  </section>
</Layout>
<script
  is:inline
  define:vars={{
    epodId: epod?.id ?? null,
    epodType: epod?.planet_type ?? "unknown",
    epodRadius: epod?.radius_earth ?? 1,
  }}
>
  const COLORS = {
    rocky: ["#8a7040", "#6a5030"],
    "super-earth": ["#3a9e75", "#1a7e55"],
    "sub-neptune": ["#4a8ed4", "#2a6eb4"],
    "neptune-like": ["#3a7ed4", "#1a5eb4"],
    "ocean-world": ["#3a7ed4", "#1a5eb4"],
    "hot-jupiter": ["#E87C1E", "#c85c0e"],
    "gas-giant": ["#8a5bc4", "#6a3ba4"],
    unknown: ["#505050", "#303030"],
  };

  const planetCanvas = document.getElementById("epod-canvas");
  const planetContext = planetCanvas.getContext("2d");
  const [color1, color2] = COLORS[epodType ?? "unknown"];
  const size = 200,
    centerX = size / 2,
    centerY = size / 2;
  const radius = Math.min(Math.max(epodRadius * 22, 12), size * 0.44);
  const gradient = planetContext.createRadialGradient(
    centerX - radius * 0.3,
    centerY - radius * 0.3,
    radius * 0.1,
    centerX,
    centerY,
    radius,
  );
  gradient.addColorStop(0, color1);
  gradient.addColorStop(1, color2);
  planetContext.beginPath();
  planetContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
  planetContext.fillStyle = gradient;
  planetContext.fill();
  planetContext.beginPath();
  planetContext.arc(
    centerX - radius * 0.25,
    centerY - radius * 0.25,
    radius * 0.35,
    0,
    Math.PI * 2,
  );
  planetContext.fillStyle = "rgba(255,255,255,0.08)";
  planetContext.fill();

  if (epodId) {
    fetch(`/api/ai/summary?id=${epodId}`)
      .then((response) => response.json())
      .then((json) => {
        const aiElement = document.getElementById("epod-ai-text");
        if (aiElement && json.summary) {
          aiElement.style.fontFamily = "var(--font-geist)";
          aiElement.style.fontSize = ".875rem";
          aiElement.style.color = "var(--ds-gray-600)";
          aiElement.textContent = json.summary;
        }
      })
      .catch(() => {
        const aiElement = document.getElementById("epod-ai-text");
        if (aiElement) aiElement.style.display = "none";
      });
  }
</script>
