---
import Layout from "@/layouts/base.astro";
import { supabaseAdmin } from "@/lib/supabase";

const batchSize = 1000;
let from = 0;
let planets = [];
let stars = [];

while (true) {
  const { data: rows, error } = await supabaseAdmin
    .from("planets")
    .select(
      "id, name, radius_earth, mass_earth, eq_temperature, planet_type, habitability_pct, stellar_temp, stellar_radius, host_star, distance_ly",
    )
    .not("radius_earth", "is", null)
    .range(from, from + batchSize - 1);

  if (error) throw error;

  planets.push(...rows);

  if (rows.length < batchSize) break;
  from += batchSize;
}

while (true) {
  const { data: rows, error } = await supabaseAdmin
    .from("planets")
    .select("host_star, stellar_temp, stellar_radius, name")
    .not("stellar_temp", "is", null)
    .not("stellar_radius", "is", null)
    .range(from, from + batchSize - 1);

  if (error) throw error;

  stars.push(...rows);

  if (rows.length < batchSize) break;
  from += batchSize;
}

const starMap = new Map<string, any>();
for (const star of stars ?? []) {
  if (!starMap.has(star.host_star)) starMap.set(star.host_star, star);
}
const uniqueStars = Array.from(starMap.values());

const radiusData = planets
  .filter(
    (planet) =>
      planet.radius_earth != null &&
      planet.radius_earth > 0 &&
      planet.radius_earth < 25,
  )
  .map((planet) => ({ radius: planet.radius_earth, type: planet.planet_type }));
---

<Layout title="Science Plots — Exoplanet Atlas">
  <section class="max-w-6xl mx-auto px-4 pb-10">
    <header class="flex items-center justify-center py-10 min-h-[12em]">
      <h1
        class="absolute text-center font-pixel-line tracking-tighter text-[12em] select-none bg-linear-0 from-black to-primary text-transparent bg-clip-text whitespace-nowrap leading-40"
      >
        Science Plots.
      </h1>

      <p class="font-mono text-md text-secondary mt-[8em] z-20">
        Real astrophysics diagrams — the same plots researchers use to study
        exoplanet populations.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 mb-6">
      <div class="bg-background-200 border border-gray-300 rounded-xl p-6">
        <div class="flex items-baseline justify-between mb-1">
          <div
            class="font-mono text-xs text-gray-600 uppercase tracking-widest"
          >
            Mass–radius diagram
          </div>
          <span class="font-mono text-xs text-gray-500" id="mr-count"></span>
        </div>
        <p class="text-[13px] text-gray-500 mb-5">
          Each dot is a planet with known mass and radius. The distinct clusters
          reveal planet families — rocky worlds, sub-Neptunes, gas giants. Hover
          to identify.
        </p>
        <div class="relative">
          <div class="rounded-sm overflow-hidden">
            <canvas
              id="mr-canvas"
              height="400"
              style="width:100%;height:400px;cursor:crosshair"></canvas>
          </div>
          <div
            id="mr-tooltip"
            class="absolute bg-background-100/75 backdrop-blur-lg border-[0.5px] border-gray-400 rounded-lg py-2 px-3 z-10 text-xs pointer-events-none"
            style="display:none;"
          >
          </div>
        </div>
      </div>

      <div class="bg-background-200 border border-gray-300 rounded-xl p-6">
        <div class="flex items-baseline justify-between mb-1">
          <div
            class="font-mono text-xs text-gray-600 uppercase tracking-widest"
          >
            Hertzsprung-Russell diagram
          </div>
          <span class="font-mono text-xs text-gray-500" id="hr-count"></span>
        </div>
        <p class="text-[13px] text-gray-500 mb-5">
          Host stars plotted by temperature (x) vs size (y). The main sequence
          diagonal, giant branch, and dwarf stars emerge from real data. Hover a
          star to see its planets.
        </p>
        <div class="relative">
          <div class="rounded-sm overflow-hidden">
            <canvas
              id="hr-canvas"
              height="400"
              style="width:100%;height:400px;cursor:crosshair"></canvas>
          </div>
          <div
            id="hr-tooltip"
            class="absolute bg-background-100/85 backdrop-blur-lg border-[0.5px] border-gray-400 rounded-lg py-2 px-3 z-10 text-xs pointer-events-none"
            style="display:none;"
          >
          </div>
        </div>
      </div>

      <div class="bg-background-200 border border-gray-300 rounded-xl p-6">
        <div class="flex items-baseline justify-between mb-1">
          <div
            class="font-mono text-xs text-gray-600 uppercase tracking-widest"
          >
            Radius gap (Fulton gap)
          </div>
          <span class="font-mono text-xs text-gray-500" id="gap-count"></span>
        </div>
        <p class="text-[13px] text-gray-500 mb-5">
          distribution of planet radii shows a mysterious gap between 1.5-2
          Earth radii, the "Fulton gap". Planets rarely have radii in this
          range. Although the gap isn't clear here, this is a real discovery
          from Kepler data.
        </p>
        <div class="rounded-sm overflow-hidden">
          <canvas id="gap-canvas" height="250" style="width:100%;height:250px;"
          ></canvas>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ planets, uniqueStars, radiusData }}>
  const planetColorMap = {
    rocky: "#8a7040",
    "super-earth": "#3a9e75",
    "sub-neptune": "#4a8ed4",
    "neptune-like": "#3a7ed4",
    "ocean-world": "#3a7ed4",
    "hot-jupiter": "#E87C1E",
    "gas-giant": "#8a5bc4",
    unknown: "#505050",
  };

  const massRadiusCanvas = document.getElementById("mr-canvas");
  const MRToolTip = document.getElementById("mr-tooltip");
  const MRCountEl = document.getElementById("mr-count");
  massRadiusCanvas.width = massRadiusCanvas.offsetWidth || 800;

  const MRWidth = massRadiusCanvas.width,
    MRHeight = massRadiusCanvas.height;
  const MRContext = massRadiusCanvas.getContext("2d");
  const chartPadding = { top: 20, right: 30, bottom: 50, left: 60 };

  const MRData = (planets ?? []).filter(
    (planet) =>
      planet.mass_earth != null &&
      planet.radius_earth != null &&
      planet.mass_earth > 0 &&
      planet.radius_earth > 0 &&
      planet.mass_earth < 5000 &&
      planet.radius_earth < 25,
  );

  MRCountEl.textContent = `${MRData.length} planets`;

  const logMassMin = Math.log10(0.1);
  const logMassMax = Math.log10(5000);
  const logRadiusMin = Math.log10(0.3);
  const logRadiusMax = Math.log10(25);

  function MassRadiusX(mass) {
    return (
      chartPadding.left +
      ((Math.log10(mass) - logMassMin) / (logMassMax - logMassMin)) *
        (MRWidth - chartPadding.left - chartPadding.right)
    );
  }

  function MassRadiusY(radius) {
    return (
      MRHeight -
      chartPadding.bottom -
      ((Math.log10(radius) - logRadiusMin) / (logRadiusMax - logRadiusMin)) *
        (MRHeight - chartPadding.top - chartPadding.bottom)
    );
  }

  function drawMRGraph() {
    MRContext.clearRect(0, 0, MRWidth, MRHeight);
    MRContext.fillStyle = "#000000";
    MRContext.fillRect(0, 0, MRWidth, MRHeight);

    MRContext.strokeStyle = "rgba(255,255,255,0.12)";
    MRContext.lineWidth = 0.5;
    [0.1, 1, 10, 100, 1000].forEach((mass) => {
      const x = MassRadiusX(mass);
      MRContext.beginPath();
      MRContext.moveTo(x, chartPadding.top);
      MRContext.lineTo(x, MRHeight - chartPadding.bottom);
      MRContext.stroke();
      MRContext.fillStyle = "rgba(255,255,255,0.3)";
      MRContext.font = "12px monospace";
      MRContext.textAlign = "center";
      MRContext.fillText(`${mass}`, x, MRHeight - chartPadding.bottom + 14);
    });
    [0.5, 1, 2, 4, 8, 15].forEach((radius) => {
      const y = MassRadiusY(radius);
      MRContext.beginPath();
      MRContext.moveTo(chartPadding.left, y);
      MRContext.lineTo(MRWidth - chartPadding.right, y);
      MRContext.stroke();
      MRContext.fillStyle = "rgba(255,255,255,0.3)";
      MRContext.font = "12px monospace";
      MRContext.textAlign = "right";
      MRContext.fillText(`${radius}`, chartPadding.left - 6, y + 3);
    });

    MRContext.fillStyle = "rgba(255,255,255,0.5)";
    MRContext.font = "14px monospace";
    MRContext.textAlign = "center";
    MRContext.fillText(
      "Mass (Earth masses, log scale)",
      MRWidth / 2,
      MRHeight - 6,
    );
    MRContext.save();
    MRContext.translate(14, MRHeight / 2);
    MRContext.rotate(-Math.PI / 2);
    MRContext.fillText("Radius (Earth radii, log scale)", 0, 0);
    MRContext.restore();

    const compositions = [
      {
        label: "Pure iron",
        slope: 0.3,
        offset: -0.1,
        color: "#da3036",
      },
      {
        label: "Earth-like",
        slope: 0.27,
        offset: 0.02,
        color: "#0c9784",
      },
      {
        label: "Water world",
        slope: 0.26,
        offset: 0.18,
        color: "#0091ff",
      },
    ];
    compositions.forEach((compo) => {
      MRContext.beginPath();
      MRContext.strokeStyle = compo.color;
      MRContext.lineWidth = 1;
      MRContext.setLineDash([4, 4]);
      let first = true;
      for (let logM = logMassMin; logM <= logMassMax; logM += 0.05) {
        const logR = compo.slope * logM + compo.offset;
        const x = MassRadiusX(Math.pow(10, logM));
        const y = MassRadiusY(Math.pow(10, logR));
        if (y < chartPadding.top || y > MRHeight - chartPadding.bottom) {
          first = true;
          continue;
        }
        first ? MRContext.moveTo(x, y) : MRContext.lineTo(x, y);
        first = false;
      }
      MRContext.stroke();
      MRContext.setLineDash([]);
      MRContext.fillStyle = compo.color;
      MRContext.font = "12px monospace";
      MRContext.textAlign = "left";
      const labelX = MassRadiusX(0.5);
      const labelY =
        MassRadiusY(
          Math.pow(10, compo.slope * Math.log10(0.5) + compo.offset),
        ) - 4;
      if (labelY > chartPadding.top)
        MRContext.fillText(compo.label, labelX, labelY);
    });

    MRData.forEach((planet) => {
      const x = MassRadiusX(planet.mass_earth);
      const y = MassRadiusY(planet.radius_earth);
      if (
        x < chartPadding.left ||
        x > MRWidth - chartPadding.right ||
        y < chartPadding.top ||
        y > MRHeight - chartPadding.bottom
      )
        return;
      MRContext.beginPath();
      MRContext.arc(x, y, 3, 0, Math.PI * 2);
      MRContext.fillStyle =
        (planetColorMap[planet.planet_type] ?? "#505050") + "cc";
      MRContext.fill();
    });

    const legendTypes = [
      "rocky",
      "super-earth",
      "sub-neptune",
      "hot-jupiter",
      "gas-giant",
    ];

    legendTypes.forEach((type, i) => {
      const legendX = chartPadding.left + i * 120;
      const legendY = chartPadding.top + 10;
      MRContext.beginPath();
      MRContext.arc(legendX, legendY, 4, 0, Math.PI * 2);
      MRContext.fillStyle = planetColorMap[type];
      MRContext.fill();
      MRContext.fillStyle = "rgba(255,255,255,0.5)";
      MRContext.font = "14px monospace";
      MRContext.textAlign = "left";
      MRContext.fillText(type, legendX + 8, legendY + 3);
    });
  }
  drawMRGraph();

  massRadiusCanvas.addEventListener("mousemove", (e) => {
    const rect = massRadiusCanvas.getBoundingClientRect();
    const mouseX = (e.clientX - rect.left) * (MRWidth / rect.width);
    const mouseY = (e.clientY - rect.top) * (MRHeight / rect.height);
    let hoveredPlanet = null;
    let minDistance = 12;

    MRData.forEach((planet) => {
      const x = MassRadiusX(planet.mass_earth);
      const y = MassRadiusY(planet.radius_earth);
      const dx = x - mouseX,
        dy = y - mouseY;
      const d = Math.sqrt(dx * dx + dy * dy);
      if (d < minDistance) {
        minDistance = d;
        hoveredPlanet = planet;
      }
    });

    if (hoveredPlanet) {
      massRadiusCanvas.style.cursor = "pointer";
      MRToolTip.style.display = "block";
      MRToolTip.style.left = `${e.clientX - massRadiusCanvas.getBoundingClientRect().left + 12}px`;
      MRToolTip.style.top = `${e.clientY - massRadiusCanvas.getBoundingClientRect().top - 10}px`;
      MRToolTip.innerHTML = `
      <div style="font-weight:500;color:var(--primary);margin-bottom:4px">${hoveredPlanet.name}</div>
      <div style="color:var(--ds-gray-600);font-family:var(--font-geist-mono);font-size:11px">${hoveredPlanet.planet_type ?? "unknown"}</div>
      <div style="color:var(--ds-gray-600);font-family:var(--font-geist-mono);font-size:11px">${Number(hoveredPlanet.radius_earth).toFixed(2)} R⊕ · ${Number(hoveredPlanet.mass_earth).toFixed(2)} M⊕</div>
      <div style="color:var(--ds-gray-500);font-family:var(--font-geist-mono);font-size:10px;margin-top:3px">click to view</div>
    `;
    } else {
      massRadiusCanvas.style.cursor = "default";
      MRToolTip.style.display = "none";
    }
  });

  massRadiusCanvas.addEventListener("mouseleave", () => {
    MRToolTip.style.display = "none";
  });

  massRadiusCanvas.addEventListener("click", (e) => {
    const rect = massRadiusCanvas.getBoundingClientRect();
    const mouseX = (e.clientX - rect.left) * (MRWidth / rect.width);
    const mouseY = (e.clientY - rect.top) * (MRHeight / rect.height);
    let hoveredPlanet = null,
      minDistance = 12;

    MRData.forEach((planet) => {
      const x = MassRadiusX(planet.mass_earth),
        y = MassRadiusY(planet.radius_earth);
      const dx = x - mouseX,
        dy = y - mouseY,
        d = Math.sqrt(dx * dx + dy * dy);
      if (d < minDistance) {
        minDistance = d;
        hoveredPlanet = planet;
      }
    });

    if (hoveredPlanet)
      window.location.href = `/planet/${hoveredPlanet.name.toLowerCase().replace(/\s+/g, "-")}`;
  });

  const HertzRussCanvas = document.getElementById("hr-canvas");
  const HRToolTip = document.getElementById("hr-tooltip");
  const HRCount = document.getElementById("hr-count");
  HertzRussCanvas.width = HertzRussCanvas.offsetWidth || 800;

  const HRCanvasW = HertzRussCanvas.width;
  const HRCanvasH = HertzRussCanvas.height;
  const HRContext = HertzRussCanvas.getContext("2d");

  HRCount.textContent = `${uniqueStars.length} host stars`;

  const minTemp = 2000,
    maxTemp = 40000;
  const minRadius = 0.05,
    maxRadius = 100;

  function HertzRussX(temp) {
    return (
      chartPadding.left +
      (1 - (temp - minTemp) / (maxTemp - minTemp)) *
        (HRCanvasW - chartPadding.left - chartPadding.right)
    );
  }
  function HertzRussY(radius) {
    return (
      HRCanvasH -
      chartPadding.bottom -
      ((Math.log10(Math.max(radius, 0.01)) - Math.log10(minRadius)) /
        (Math.log10(maxRadius) - Math.log10(minRadius))) *
        (HRCanvasH - chartPadding.top - chartPadding.bottom)
    );
  }

  function stellarColor(temp) {
    if (!temp) return "#aaaaaa";
    if (temp > 30000) return "#9bb0ff";
    if (temp > 10000) return "#aabfff";
    if (temp > 7500) return "#f8f7ff";
    if (temp > 6000) return "#fff4e8";
    if (temp > 5200) return "#ffdd90";
    if (temp > 3700) return "#ffb347";
    return "#ff6b35";
  }

  function drawHR() {
    HRContext.clearRect(0, 0, HRCanvasW, HRCanvasH);
    HRContext.fillStyle = "#000000";
    HRContext.fillRect(0, 0, HRCanvasW, HRCanvasH);

    const stellarColorBands = [
      {
        minTemp: 30000,
        maxTemp: 40000,
        color: "#000001",
        label: "O",
      },
      {
        minTemp: 10000,
        maxTemp: 30000,
        color: "#00002030",
        label: "B",
      },
      {
        minTemp: 7500,
        maxTemp: 10000,
        color: "#ffffff05",
        label: "A",
      },
      {
        minTemp: 6000,
        maxTemp: 7500,
        color: "#ffffc510",
        label: "F",
      },
      { minTemp: 5200, maxTemp: 6000, color: "#e79c1317", label: "G" },
      { minTemp: 3700, maxTemp: 5200, color: "#ff3c0017", label: "K" },
      { minTemp: 2000, maxTemp: 3700, color: "#ff000017", label: "M" },
    ];
    stellarColorBands.forEach((band) => {
      const x1 = HertzRussX(band.maxTemp),
        x2 = HertzRussX(band.minTemp);
      HRContext.fillStyle = band.color;
      HRContext.fillRect(
        x1,
        chartPadding.top,
        x2 - x1,
        HRCanvasH - chartPadding.top - chartPadding.bottom,
      );
      HRContext.fillStyle = "rgba(255,255,255,0.5)";
      HRContext.font = "12px monospace";
      HRContext.textAlign = "center";
      HRContext.fillText(band.label, (x1 + x2) / 2, chartPadding.top + 14);
    });

    HRContext.strokeStyle = "rgba(255,255,255,0.12)";
    HRContext.lineWidth = 0.5;
    [3000, 5000, 8000, 12000, 20000, 35000].forEach((temp) => {
      const x = HertzRussX(temp);
      HRContext.beginPath();
      HRContext.moveTo(x, chartPadding.top);
      HRContext.lineTo(x, HRCanvasH - chartPadding.bottom);
      HRContext.stroke();
      HRContext.fillStyle = "rgba(255,255,255,0.3)";
      HRContext.font = "12px monospace";
      HRContext.textAlign = "center";
      HRContext.fillText(
        `${(temp / 1000).toFixed(0)}k K`,
        x,
        HRCanvasH - chartPadding.bottom + 14,
      );
    });
    [0.1, 0.5, 1, 2, 5, 10, 50].forEach((radius) => {
      const y = HertzRussY(radius);
      if (y < chartPadding.top || y > HRCanvasH - chartPadding.bottom) return;
      HRContext.beginPath();
      HRContext.moveTo(chartPadding.left, y);
      HRContext.lineTo(HRCanvasW - chartPadding.right, y);
      HRContext.stroke();
      HRContext.fillStyle = "rgba(255,255,255,0.3)";
      HRContext.font = "11px monospace";
      HRContext.textAlign = "right";
      HRContext.fillText(`${radius}R☉`, chartPadding.left - 5, y + 3);
    });

    HRContext.fillStyle = "rgba(255,255,255,0.5)";
    HRContext.font = "12px monospace";
    HRContext.textAlign = "center";
    HRContext.fillText("Temperature (K)", MRWidth / 2, HRCanvasH - 6);
    HRContext.save();
    HRContext.translate(14, HRCanvasH / 2);
    HRContext.rotate(-Math.PI / 2);
    HRContext.fillText("Radius (solar radii, log scale)", 0, 0);
    HRContext.restore();

    const sunX = HertzRussX(5778),
      sunY = HertzRussY(1);
    HRContext.beginPath();
    HRContext.arc(sunX, sunY, 5, 0, Math.PI * 2);
    HRContext.fillStyle = "#ffd060";
    HRContext.fill();
    HRContext.fillStyle = "rgba(255,208,96,0.6)";
    HRContext.font = "12px monospace";
    HRContext.textAlign = "left";
    HRContext.fillText("Sun", sunX + 7, sunY + 3);

    uniqueStars.forEach((star) => {
      const x = HertzRussX(star.stellar_temp);
      const y = HertzRussY(star.stellar_radius);
      if (
        x < chartPadding.left ||
        x > HRCanvasW - chartPadding.right ||
        y < chartPadding.top ||
        y > HRCanvasH - chartPadding.bottom
      )
        return;
      HRContext.beginPath();
      HRContext.arc(x, y, 2.5, 0, Math.PI * 2);
      HRContext.fillStyle = stellarColor(star.stellar_temp) + "bb";
      HRContext.fill();
    });
  }

  drawHR();

  HertzRussCanvas.addEventListener("mousemove", (e) => {
    const rect = HertzRussCanvas.getBoundingClientRect();
    const mouseX = (e.clientX - rect.left) * (HRCanvasW / rect.width);
    const mouseY = (e.clientY - rect.top) * (HRCanvasH / rect.height);
    let hoveredStar = null,
      minDist = 10;

    uniqueStars.forEach((star) => {
      const x = HertzRussX(star.stellar_temp),
        y = HertzRussY(star.stellar_radius);
      const dx = x - mouseX,
        dy = y - mouseY,
        d = Math.sqrt(dx * dx + dy * dy);
      if (d < minDist) {
        minDist = d;
        hoveredStar = star;
      }
    });

    if (hoveredStar) {
      HertzRussCanvas.style.cursor = "pointer";
      HRToolTip.style.display = "block";
      HRToolTip.style.left = `${e.clientX - HertzRussCanvas.getBoundingClientRect().left + 12}px`;
      HRToolTip.style.top = `${e.clientY - HertzRussCanvas.getBoundingClientRect().top - 10}px`;
      HRToolTip.innerHTML = `
      <div style="font-weight:500;color:var(--primary);margin-bottom:4px">${hoveredStar.host_star}</div>
      <div style="color:var(--ds-gray-600);font-family:var(--font-geist-mono);font-size:11px">${Math.round(hoveredStar.stellar_temp).toLocaleString()} K</div>
      <div style="color:var(--ds-gray-600);font-family:var(--font-geist-mono);font-size:11px">${Number(hoveredStar.stellar_radius).toFixed(2)} R☉</div>
      <div style="color:var(--ds-gray-500);font-family:var(--font-geist-mono);font-size:10px;margin-top:3px">click to view planet</div>
    `;
    } else {
      HertzRussCanvas.style.cursor = "default";
      HRToolTip.style.display = "none";
    }
  });

  HertzRussCanvas.addEventListener("mouseleave", () => {
    HRToolTip.style.display = "none";
  });

  HertzRussCanvas.addEventListener("click", (e) => {
    const rect = HertzRussCanvas.getBoundingClientRect();
    const mouseX = (e.clientX - rect.left) * (HRCanvasW / rect.width);
    const mouseY = (e.clientY - rect.top) * (HRCanvasH / rect.height);
    let hoveredStar = null,
      minDist = 10;

    uniqueStars.forEach((star) => {
      const x = HertzRussX(star.stellar_temp),
        y = HertzRussY(star.stellar_radius);
      const dx = x - mouseX,
        dy = y - mouseY,
        d = Math.sqrt(dx * dx + dy * dy);
      if (d < minDist) {
        minDist = d;
        hoveredStar = star;
      }
    });

    if (hoveredStar)
      window.location.href = `/planet/${hoveredStar.name.toLowerCase().replace(/\s+/g, "-")}`;
  });

  const FGCanvas = document.getElementById("gap-canvas");
  const FGCount = document.getElementById("gap-count");

  const FGContext = FGCanvas.getContext("2d");
  FGCanvas.width = FGCanvas.offsetWidth || 800;
  const FGCanvasW = FGCanvas.width;
  const FGCanvasH = FGCanvas.height;

  const BINS = 100;
  const BIN_MAX = 5;
  const binSize = BIN_MAX / BINS;
  const counts = new Array(BINS).fill(0);

  radiusData.forEach((planet) => {
    const bin = Math.floor(planet.radius / binSize);
    if (bin >= 0 && bin < BINS) counts[bin]++;
  });
  console.log(radiusData);
  const maxCount = Math.max(...counts);
  FGCount.textcontent = `${radiusData.length} planets`;

  FGContext.fillStyle = "#000000";
  FGContext.fillRect(0, 0, FGCanvasW, FGCanvasH);

  const FGPadding = { top: 20, right: 20, left: 50, bottom: 40 };
  const barWidth = (FGCanvasW - FGPadding.left - FGPadding.right) / BINS;

  const gapX1 =
    FGPadding.left +
    (1.5 / BIN_MAX) * (FGCanvasW - FGPadding.left - FGPadding.right);
  const gapX2 =
    FGPadding.left +
    (2 / BIN_MAX) * (FGCanvasW - FGPadding.left - FGPadding.right);

  FGContext.fillStyle = "rgba(239,68,68,0.08)";
  FGContext.fillRect(
    gapX1,
    FGPadding.top - 10,
    gapX2 - gapX1,
    FGCanvasH - FGPadding.top - FGPadding.bottom,
  );
  FGContext.fillStyle = "#da3036";
  FGContext.font = "12px monospace";
  FGContext.textAlign = "center";
  FGContext.fillText("Fulton gap", (gapX1 + gapX2) / 2, FGPadding.top + 8);

  counts.forEach((count, i) => {
    const X = FGPadding.left + i * barWidth;
    const barHeight =
      (count / maxCount) * (FGCanvasH - FGPadding.top - FGPadding.bottom);
    const barY = FGCanvasH - FGPadding.bottom - barHeight;
    const rVal = i * binSize;
    const col =
      rVal < 1.5
        ? "#e79c13"
        : rVal < 2.0
          ? "#da303675"
          : rVal < 3
            ? "#0091ff"
            : rVal < 4
              ? "#1a9338"
              : "#8a5bc4";

    FGContext.fillStyle = col;
    FGContext.fillRect(X + 0.5, barY, barWidth - 1, barHeight);
  });

  [0, 1, 1.5, 2, 3, 4, 5, 6].forEach((r) => {
    const X =
      FGPadding.left +
      (r / BIN_MAX) * (FGCanvasW - FGPadding.left - FGPadding.right);
    FGContext.fillStyle = "rgba(255,255,255,0.3)";
    FGContext.font = "12px monospace";
    FGContext.textAlign = "center";
    FGContext.fillText(`${r}`, X, FGCanvasH - FGPadding.bottom + 14);
    FGContext.strokeStyle = "rgba(255,255,255,0.05)";
    FGContext.lineWidth = 0.5;
    FGContext.beginPath();
    FGContext.moveTo(X, FGPadding.top);
    FGContext.lineTo(X, FGCanvasH - FGPadding.bottom);
    FGContext.stroke();
  });

  FGContext.fillStyle = "rgba(255,255,255,0.5)";
  FGContext.font = "12px monospace";
  FGContext.textAlign = "center";
  FGContext.fillText(
    "planet radius (Earth radii)",
    FGCanvasW / 2,
    FGCanvasH - 4,
  );
  FGContext.save();
  FGContext.translate(14, FGCanvasH / 2);
  FGContext.rotate(-Math.PI / 2);
  FGContext.fillText("Number of planets", 0, 0);
  FGContext.restore();
</script>
